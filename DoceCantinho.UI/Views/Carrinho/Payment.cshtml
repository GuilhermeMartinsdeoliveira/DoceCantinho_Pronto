@using DoceCantinho.UI.ViewModels
@{
    ViewData["Title"] = "Pagamento";
    var order = ViewData["Order"];
    var cartoes = ViewBag.Cartoes as List<CartaoResumoViewModel> ?? new List<CartaoResumoViewModel>();
}

<style>
    .payment-wrap { max-width:860px; margin:2.5rem auto; background:var(--card); padding:2rem; border-radius:var(--radius); border:1px solid var(--border); }
    .order-items { margin-top:1.4rem; border-top:1px solid var(--border); padding-top:1.2rem; }
    .payment-methods { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-top:1.2rem; }
    .payment-option { padding:1rem; border:1px solid var(--border); border-radius:10px; cursor:pointer; }
    .payment-option input { margin-right:.4rem; }
    .saved-card-area { margin-top:1.2rem; padding:1.2rem; border:1px solid var(--border); border-radius:10px; background:rgba(255,255,255,.015); }
    .saved-card-area label { display:block; margin-bottom:.5rem; font-weight:700; }
    .saved-card-area select { width:100%; padding:.85rem; border:1px solid var(--border); border-radius:8px; background:var(--bg); color:var(--fg); }
    .payment-alert { margin-bottom:1rem; padding:.9rem 1rem; border-radius:8px; background:#40221e; border:1px solid #8b4c43; color:#f2c8c2; }
    .payment-btn { margin-top:1.2rem; padding:.85rem 1.3rem; border:0; border-radius:8px; background:var(--primary); color:white; font-weight:700; cursor:pointer; }
    .payment-link { color:var(--primary); font-weight:700; text-decoration:none; }
    @@media(max-width:650px) { .payment-methods { grid-template-columns:1fr; } }
</style>

<div class="payment-wrap">
    <h2>Pagamento do pedido</h2>

    @if (TempData["PagamentoErro"] != null)
    {
        <div class="payment-alert">@TempData["PagamentoErro"]</div>
    }

    <div>
        <strong>Cliente:</strong> @(((dynamic)order).NomeCliente) <br />
        <strong>Telefone:</strong> @(((dynamic)order).Telefone) <br />
        <strong>Endereço:</strong> @(((dynamic)order).Endereco ?? "-") <br />
        <strong>Total:</strong> R$ @(((dynamic)order).Total.ToString("F2"))
    </div>

    <div class="order-items">
        <h4>Itens</h4>
        <ul>
            @foreach (var it in ((dynamic)order).Items)
            {
                <li>@it.Nome — @it.Quantidade x R$ @it.Preco.ToString("F2") = R$ @it.Subtotal.ToString("F2")</li>
            }
        </ul>
    </div>

    <form method="post" asp-action="Payment">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderId" value="@(((dynamic)order).Id)" />

        <div class="payment-methods">
            <label class="payment-option">
                <input type="radio" name="paymentMethod" value="CartaoCredito" checked />
                Cartão de Crédito
            </label>
            <label class="payment-option">
                <input type="radio" name="paymentMethod" value="CartaoDebito" />
                Cartão de Débito
            </label>
            <label class="payment-option">
                <input type="radio" name="paymentMethod" value="Pix" />
                Pix
            </label>
        </div>

        <div class="saved-card-area" id="saved-card-area">
            <label for="cartaoId">Escolha um cartão cadastrado</label>

            @if (cartoes.Any())
            {
                <select name="cartaoId" id="cartaoId">
                    <option value="">Selecione seu cartão</option>
                    @foreach (var cartao in cartoes)
                    {
                        <option value="@cartao.Id" data-tipo="@cartao.Tipo">
                            @cartao.TipoFormatado · @cartao.Bandeira •••• @cartao.Ultimos4 · @cartao.Validade
                        </option>
                    }
                </select>
                <div style="margin-top:.7rem; font-size:.8rem; color:var(--muted-fg);">
                    Precisa cadastrar outro cartão?
                    <a class="payment-link" href="/Cartoes">Meus Cartões</a>
                </div>
            }
            else
            {
                <div style="color:var(--muted-fg);">
                    Você ainda não possui cartões cadastrados.
                    <a class="payment-link" href="/Cartoes">Cadastrar cartão</a>
                </div>
            }
        </div>

        <button type="submit" class="payment-btn">Confirmar pagamento</button>
    </form>

    <script>
        const radios = document.querySelectorAll('input[name="paymentMethod"]');
        const savedArea = document.getElementById('saved-card-area');
        const select = document.getElementById('cartaoId');

        function atualizarCartao() {
            const method = document.querySelector('input[name="paymentMethod"]:checked')?.value;
            const isCard = method === 'CartaoCredito' || method === 'CartaoDebito';
            if (savedArea) savedArea.style.display = isCard ? 'block' : 'none';

            if (select) {
                Array.from(select.options).forEach(option => {
                    if (!option.value) return;
                    const tipo = option.dataset.tipo;
                    const esperado = method === 'CartaoCredito' ? 'Credito' : method === 'CartaoDebito' ? 'Debito' : '';
                    option.hidden = !!esperado && tipo !== esperado;
                });
                if (select.selectedOptions[0]?.hidden) select.value = '';
            }
        }

        radios.forEach(radio => radio.addEventListener('change', atualizarCartao));
        atualizarCartao();
    </script>
</div>
