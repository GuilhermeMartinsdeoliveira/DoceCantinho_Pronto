@using DoceCantinho.Application.DTOs
@model CreatePedidoDto

@{
    ViewData["Title"] = "Novo Pedido";
}

<div class="novo-pedido-page">

    <!-- CABEÇALHO -->

    <div class="novo-pedido-header">

        <div>

            <div class="novo-pedido-eyebrow">
                <i class="bi bi-bag-heart"></i>
                DOCE CANTINHO
            </div>

            <h1>Novo Pedido</h1>

            <p>
                Preencha os dados abaixo para registrar um novo pedido.
            </p>

        </div>

        <a href="@Url.Action("Index", "Pedidos")"
           class="novo-btn novo-btn-back">

            <i class="bi bi-arrow-left"></i>
            Voltar aos pedidos

        </a>

    </div>


    <!-- ERROS -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="novo-alert">

            <div class="novo-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div>

                <strong>
                    Não foi possível criar o pedido
                </strong>

                <ul>
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        foreach (var error in modelState.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>

            </div>

        </div>
    }


    <form method="post"
          action="@Url.Action("Create", "Pedidos")">

        @Html.AntiForgeryToken()


        <div class="novo-pedido-layout">

            <!-- ============================
                 COLUNA ESQUERDA
                 ============================ -->

            <div>


                <!-- CLIENTE -->

                <section class="novo-card">

                    <div class="novo-card-title">

                        <div class="novo-title-icon">
                            <i class="bi bi-person"></i>
                        </div>

                        <div>

                            <h2>Informações do cliente</h2>

                            <p>
                                Dados necessários para o pedido
                            </p>

                        </div>

                    </div>


                    <div class="novo-form-grid">

                        <div class="novo-field">

                            <label for="NomeCliente">
                                Nome do Cliente
                                <span>*</span>
                            </label>

                            <div class="novo-input">

                                <i class="bi bi-person"></i>

                                <input type="text"
                                       id="NomeCliente"
                                       name="NomeCliente"
                                       value="@Model.NomeCliente"
                                       placeholder="Digite o nome do cliente"
                                       required />

                            </div>

                            <span class="text-danger">
                                @Html.ValidationMessage("NomeCliente")
                            </span>

                        </div>


                        <div class="novo-field">

                            <label for="Telefone">
                                Telefone
                            </label>

                            <div class="novo-input">

                                <i class="bi bi-telephone"></i>

                                <input type="tel"
                                       id="Telefone"
                                       name="Telefone"
                                       value="@Model.Telefone"
                                       placeholder="(11) 99999-9999" />

                            </div>

                            <span class="text-danger">
                                @Html.ValidationMessage("Telefone")
                            </span>

                        </div>

                    </div>


                    <div class="novo-field">

                        <label for="Endereco">
                            Endereço
                        </label>

                        <div class="novo-input novo-textarea">

                            <i class="bi bi-geo-alt"></i>

                            <textarea id="Endereco"
                                      name="Endereco"
                                      rows="3"
                                      placeholder="Rua, número, complemento e CEP">@Model.Endereco</textarea>

                        </div>

                        <span class="text-danger">
                            @Html.ValidationMessage("Endereco")
                        </span>

                    </div>

                </section>


                <!-- PAGAMENTO -->

                <section class="novo-card">

                    <div class="novo-card-title">

                        <div class="novo-title-icon">
                            <i class="bi bi-credit-card"></i>
                        </div>

                        <div>

                            <h2>Pagamento</h2>

                            <p>
                                Escolha a forma de pagamento
                            </p>

                        </div>

                    </div>


                    <div class="novo-form-grid">

                        <div class="novo-field">

                            <label for="PaymentMethod">
                                Forma de pagamento
                                <span>*</span>
                            </label>

                            <div class="novo-input">

                                <i class="bi bi-wallet2"></i>

                                <select id="PaymentMethod"
                                        name="PaymentMethod"
                                        required>

                                    <option value="">
                                        Selecione uma opção
                                    </option>

                                    <option value="Cartão de Crédito"
                                            selected="@(Model.PaymentMethod == "Cartão de Crédito")">
                                        Cartão de Crédito
                                    </option>

                                    <option value="Cartão de Débito"
                                            selected="@(Model.PaymentMethod == "Cartão de Débito")">
                                        Cartão de Débito
                                    </option>

                                    <option value="PIX"
                                            selected="@(Model.PaymentMethod == "PIX")">
                                        PIX
                                    </option>

                                    <option value="Dinheiro"
                                            selected="@(Model.PaymentMethod == "Dinheiro")">
                                        Dinheiro
                                    </option>

                                </select>

                            </div>

                        </div>


                        <div class="novo-field">

                            <label for="Total">
                                Total
                                <span>*</span>
                            </label>

                            <div class="novo-input">

                                <span class="currency">
                                    R$
                                </span>

                                <input type="number"
                                       id="Total"
                                       name="Total"
                                       value="@Model.Total"
                                       step="0.01"
                                       min="0"
                                       required />

                            </div>

                        </div>

                    </div>

                </section>


                <!-- ITENS -->

                <section class="novo-card">

                    <div class="novo-card-title novo-card-title-items">

                        <div>

                            <div class="novo-title-icon">
                                <i class="bi bi-cake2"></i>
                            </div>

                        </div>

                        <div>

                            <h2>Itens do pedido</h2>

                            <p>
                                Adicione os doces escolhidos pelo cliente
                            </p>

                        </div>

                    </div>


                    <div id="items-container">

                        @if (Model.Items != null && Model.Items.Count > 0)
                        {
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="novo-item"
                                     data-item-index="@i">

                                    <div class="novo-item-photo">

                                        <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500&h=500&fit=crop&auto=format"
                                             alt="Bolo de chocolate" />

                                    </div>


                                    <div class="novo-item-content">

                                        <div class="novo-item-top">

                                            <strong>
                                                Item @(i + 1)
                                            </strong>

                                            <button type="button"
                                                    class="novo-remove remove-item">

                                                <i class="bi bi-trash3"></i>

                                                Remover

                                            </button>

                                        </div>


                                        <div class="novo-item-grid">

                                            <div class="novo-field">

                                                <label>
                                                    Produto / Nome *
                                                </label>

                                                <input type="text"
                                                       class="form-control"
                                                       name="Items[@i].Nome"
                                                       value="@Model.Items[i].Nome"
                                                       placeholder="Ex: Bolo de chocolate"
                                                       required />

                                            </div>


                                            <div class="novo-field">

                                                <label>
                                                    DoceId
                                                </label>

                                                <input type="number"
                                                       class="form-control"
                                                       name="Items[@i].DoceId"
                                                       value="@Model.Items[i].DoceId"
                                                       min="0" />

                                            </div>


                                            <div class="novo-field">

                                                <label>
                                                    Preço *
                                                </label>

                                                <div class="mini-input">

                                                    <span>R$</span>

                                                    <input type="number"
                                                           class="preco-input"
                                                           name="Items[@i].Preco"
                                                           value="@Model.Items[i].Preco"
                                                           step="0.01"
                                                           min="0"
                                                           required />

                                                </div>

                                            </div>


                                            <div class="novo-field">

                                                <label>
                                                    Quantidade *
                                                </label>

                                                <input type="number"
                                                       class="quantidade-input"
                                                       name="Items[@i].Quantidade"
                                                       value="@Model.Items[i].Quantidade"
                                                       min="1"
                                                       required />

                                            </div>

                                        </div>


                                        <div class="novo-subtotal">

                                            <span>
                                                Subtotal
                                            </span>

                                            <strong>
                                                R$
                                                <span class="subtotal">
                                                    @((Model.Items[i].Preco * Model.Items[i].Quantidade).ToString("F2"))
                                                </span>
                                            </strong>

                                        </div>

                                    </div>

                                </div>
                            }
                        }

                    </div>


                    <button type="button"
                            id="add-item-btn"
                            class="novo-add-item">

                        <i class="bi bi-plus-circle"></i>

                        Adicionar outro doce

                    </button>

                </section>

            </div>


            <!-- ============================
                 RESUMO
                 ============================ -->

            <aside class="novo-summary">

                <div class="summary-image">

                    <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=800&h=500&fit=crop&auto=format"
                         alt="Bolo de chocolate" />

                </div>


                <div class="summary-content">

                    <span class="summary-label">
                        RESUMO DO PEDIDO
                    </span>

                    <h2>
                        Quase pronto! 🍰
                    </h2>

                    <p>
                        Confira os dados antes de finalizar o pedido.
                    </p>


                    <div class="summary-line">

                        <span>
                            Cliente
                        </span>

                        <strong id="summary-client">
                            @(string.IsNullOrWhiteSpace(Model.NomeCliente)
                                ? "Não informado"
                                : Model.NomeCliente)
                        </strong>

                    </div>


                    <div class="summary-line">

                        <span>
                            Pagamento
                        </span>

                        <strong id="summary-payment">
                            @(string.IsNullOrWhiteSpace(Model.PaymentMethod)
                                ? "Não informado"
                                : Model.PaymentMethod)
                        </strong>

                    </div>


                    <div class="summary-total">

                        <span>
                            Total
                        </span>

                        <strong>
                            R$
                            <span id="summary-total">
                                @Model.Total.ToString("N2")
                            </span>
                        </strong>

                    </div>


                    <button type="submit"
                            class="novo-submit">

                        <i class="bi bi-check2-circle"></i>

                        Criar Pedido

                    </button>


                    <a href="@Url.Action("Index", "Pedidos")"
                       class="novo-cancel">

                        <i class="bi bi-x-circle"></i>

                        Cancelar

                    </a>

                </div>

            </aside>

        </div>

    </form>

</div>


<script>

document.addEventListener("DOMContentLoaded", function () {

    let itemCount =
        document.querySelectorAll(".novo-item").length;


    function updateSubtotal(row) {

        const precoInput =
            row.querySelector(".preco-input");

        const quantidadeInput =
            row.querySelector(".quantidade-input");

        const subtotal =
            row.querySelector(".subtotal");


        const preco =
            parseFloat(precoInput?.value) || 0;

        const quantidade =
            parseInt(quantidadeInput?.value) || 0;


        subtotal.textContent =
            (preco * quantidade).toFixed(2);

    }


    function attachListeners(row) {

        const preco =
            row.querySelector(".preco-input");

        const quantidade =
            row.querySelector(".quantidade-input");

        preco.addEventListener(
            "input",
            function () {
                updateSubtotal(row);
            }
        );

        quantidade.addEventListener(
            "input",
            function () {
                updateSubtotal(row);
            }
        );


        const remove =
            row.querySelector(".remove-item");

        remove.addEventListener(
            "click",
            function () {

                row.remove();

                atualizarIndices();

            }
        );

    }


    function atualizarIndices() {

        const rows =
            document.querySelectorAll(".novo-item");


        rows.forEach(function (row, index) {

            row.dataset.itemIndex = index;


            row.querySelectorAll("input").forEach(function (input) {

                input.name =
                    input.name.replace(
                        /Items\[\d+\]/,
                        "Items[" + index + "]"
                    );

            });


            const itemTitle =
                row.querySelector(".novo-item-top strong");

            if (itemTitle) {

                itemTitle.textContent =
                    "Item " + (index + 1);

            }

        });


        itemCount = rows.length;

        atualizarTotal();

    }


    function atualizarTotal() {

        let total = 0;


        document.querySelectorAll(".novo-item")
            .forEach(function (row) {

                const preco =
                    parseFloat(
                        row.querySelector(".preco-input")?.value
                    ) || 0;

                const quantidade =
                    parseInt(
                        row.querySelector(".quantidade-input")?.value
                    ) || 0;

                total += preco * quantidade;

            });


        document.getElementById("Total").value =
            total.toFixed(2);

        document.getElementById("summary-total")
            .textContent =
            total.toFixed(2);

    }


    document
        .querySelectorAll(".novo-item")
        .forEach(function (row) {

            attachListeners(row);

        });


    document
        .getElementById("add-item-btn")
        .addEventListener("click", function () {

            const container =
                document.getElementById("items-container");


            const index =
                itemCount;


            const row =
                document.createElement("div");


            row.className = "novo-item";

            row.dataset.itemIndex = index;


            row.innerHTML = `

                <div class="novo-item-photo">

                    <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307?w=500&h=500&fit=crop&auto=format"
                         alt="Doce artesanal" />

                </div>


                <div class="novo-item-content">

                    <div class="novo-item-top">

                        <strong>
                            Item ${index + 1}
                        </strong>

                        <button type="button"
                                class="novo-remove remove-item">

                            <i class="bi bi-trash3"></i>
                            Remover

                        </button>

                    </div>


                    <div class="novo-item-grid">

                        <div class="novo-field">

                            <label>
                                Produto / Nome *
                            </label>

                            <input type="text"
                                   class="form-control"
                                   name="Items[${index}].Nome"
                                   placeholder="Ex: Brigadeiro gourmet"
                                   required />

                        </div>


                        <div class="novo-field">

                            <label>
                                DoceId
                            </label>

                            <input type="number"
                                   class="form-control"
                                   name="Items[${index}].DoceId"
                                   min="0" />

                        </div>


                        <div class="novo-field">

                            <label>
                                Preço *
                            </label>

                            <div class="mini-input">

                                <span>R$</span>

                                <input type="number"
                                       class="preco-input"
                                       name="Items[${index}].Preco"
                                       step="0.01"
                                       min="0"
                                       required />

                            </div>

                        </div>


                        <div class="novo-field">

                            <label>
                                Quantidade *
                            </label>

                            <input type="number"
                                   class="quantidade-input"
                                   name="Items[${index}].Quantidade"
                                   min="1"
                                   value="1"
                                   required />

                        </div>

                    </div>


                    <div class="novo-subtotal">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            R$
                            <span class="subtotal">
                                0.00
                            </span>
                        </strong>

                    </div>

                </div>

            `;


            container.appendChild(row);


            attachListeners(row);


            itemCount++;


            atualizarIndices();

        });


    document
        .getElementById("NomeCliente")
        .addEventListener("input", function () {

            document.getElementById("summary-client")
                .textContent =
                this.value || "Não informado";

        });


    document
        .getElementById("PaymentMethod")
        .addEventListener("change", function () {

            document.getElementById("summary-payment")
                .textContent =
                this.value || "Não informado";

        });


    document
        .getElementById("Total")
        .addEventListener("input", function () {

            document.getElementById("summary-total")
                .textContent =
                (parseFloat(this.value) || 0)
                    .toFixed(2);

        });

});

</script>


<style>

.novo-pedido-page {

    max-width: 1200px;
    margin: 0 auto;
    padding: 45px 25px 80px;

}


/* HEADER */

.novo-pedido-header {

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 35px;

}

.novo-pedido-eyebrow {

    color: #C96B45;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1.5px;

}

.novo-pedido-header h1 {

    color: #3D2314;
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    margin: 7px 0;

}

.novo-pedido-header p {

    color: #8A6555;
    margin: 0;

}


.novo-btn-back {

    border: 1px solid #D9C8BB;
    color: #5C2E0E;
    padding: 11px 16px;
    border-radius: 11px;
    text-decoration: none;
    font-weight: 700;

}

.novo-btn-back:hover {

    color: white;
    background: #3D2314;

}


/* LAYOUT */

.novo-pedido-layout {

    display: grid;
    grid-template-columns: minmax(0, 1fr) 350px;
    gap: 25px;
    align-items: start;

}


/* CARD */

.novo-card {

    background: #FFF9F3;
    border: 1px solid #EBDDD1;
    border-radius: 20px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 7px 25px rgba(70,35,15,.05);

}


.novo-card-title {

    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 25px;

}

.novo-title-icon {

    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #F4E5DB;
    color: #C96B45;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;

}

.novo-card-title h2 {

    margin: 0;
    color: #3D2314;
    font-family: 'Playfair Display', serif;
    font-size: 21px;

}

.novo-card-title p {

    margin: 3px 0 0;
    color: #9A7A6B;
    font-size: 13px;

}


/* FORM */

.novo-form-grid {

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;

}

.novo-field {

    margin-bottom: 17px;

}

.novo-field label {

    display: block;
    color: #5B4032;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 7px;

}

.novo-field label span {

    color: #C96B45;

}


.novo-input {

    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 47px;
    padding: 0 13px;
    border: 1px solid #DDCEC2;
    border-radius: 11px;
    background: white;
    transition: .2s;

}

.novo-input:focus-within {

    border-color: #C96B45;
    box-shadow: 0 0 0 3px rgba(201,107,69,.10);

}

.novo-input > i {

    color: #B78974;

}

.novo-input input,
.novo-input select,
.novo-input textarea {

    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: #3D2314;

}

.novo-input textarea {

    padding: 12px 0;
    resize: vertical;

}

.novo-textarea {

    align-items: flex-start;
    padding-top: 5px;

}

.currency {

    color: #C96B45;
    font-weight: 800;

}


/* ITENS */

.novo-item {

    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 18px;
    background: #FFFDF9;
    border: 1px solid #E8D9CD;
    border-radius: 16px;
    padding: 15px;
    margin-bottom: 14px;

}


.novo-item-photo {

    width: 90px;
    height: 90px;
    border-radius: 13px;
    overflow: hidden;

}

.novo-item-photo img {

    width: 100%;
    height: 100%;
    object-fit: cover;

}


.novo-item-top {

    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;

}

.novo-item-top strong {

    color: #3D2314;

}


.novo-remove {

    border: none;
    background: transparent;
    color: #D64545;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;

}


.novo-item-grid {

    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 12px;

}

.novo-item-grid .form-control {

    width: 100%;
    height: 43px;
    border: 1px solid #DDCEC2;
    border-radius: 9px;
    padding: 0 10px;
    outline: none;

}


.mini-input {

    display: flex;
    align-items: center;
    height: 43px;
    border: 1px solid #DDCEC2;
    border-radius: 9px;
    background: white;
    overflow: hidden;

}

.mini-input span {

    padding: 0 9px;
    color: #C96B45;
    font-weight: 700;

}

.mini-input input {

    width: 100%;
    height: 100%;
    border: none;
    outline: none;

}


.novo-subtotal {

    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    padding-top: 12px;
    border-top: 1px solid #EBDDD1;

}

.novo-subtotal span {

    color: #8D6D5D;

}

.novo-subtotal strong {

    color: #C96B45;

}


.novo-add-item {

    width: 100%;
    border: 1px dashed #C96B45;
    background: #FFF8F2;
    color: #C96B45;
    padding: 13px;
    border-radius: 11px;
    font-weight: 800;
    cursor: pointer;

}

.novo-add-item:hover {

    background: #C96B45;
    color: white;

}


/* RESUMO */

.novo-summary {

    position: sticky;
    top: 85px;
    background: #3D2314;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(61,35,20,.18);

}

.summary-image {

    height: 190px;

}

.summary-image img {

    width: 100%;
    height: 100%;
    object-fit: cover;

}

.summary-content {

    padding: 25px;

}

.summary-label {

    color: #E4A483;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;

}

.summary-content h2 {

    color: white;
    font-family: 'Playfair Display', serif;
    margin: 7px 0;

}

.summary-content > p {

    color: #D9C0B2;
    font-size: 13px;
    margin-bottom: 25px;

}


.summary-line {

    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,.12);

}

.summary-line span {

    color: #CBAE9F;
    font-size: 12px;

}

.summary-line strong {

    color: white;
    font-size: 12px;
    text-align: right;

}


.summary-total {

    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 5px;

}

.summary-total span {

    color: #DCC2B5;

}

.summary-total strong {

    color: #E5A078;
    font-size: 24px;

}


.novo-submit {

