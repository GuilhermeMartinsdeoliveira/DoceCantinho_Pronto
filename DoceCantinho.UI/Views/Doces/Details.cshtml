@model DoceCantinho.Application.ViewModels.DoceDetailsViewModel

@{
    ViewData["Title"] = Model?.Doce?.Title ?? "Detalhes";
    var doce = Model?.Doce;
}

<div class="page active" id="page-detalhes">

    <div class="container detalhes-container">

        <!-- VOLTAR PARA A LOJA -->
        <a asp-action="Index" class="detalhes-voltar">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 width="17"
                 height="17">

                <line x1="19"
                      y1="12"
                      x2="5"
                      y2="12" />

                <polyline points="12 19 5 12 12 5" />

            </svg>

            Voltar à loja

        </a>


        <!-- DETALHES DO PRODUTO -->
        <div class="detalhes-grid">

            <!-- IMAGEM -->
            <div class="detalhes-imagem-area">

                @if (!string.IsNullOrEmpty(doce?.CoverImageUrl))
                {
                    <img src="@doce.CoverImageUrl"
                         alt="@doce.Title"
                         class="detalhes-imagem" />
                }
                else
                {
                    <div class="detalhes-imagem-placeholder">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.5"
                             width="80"
                             height="80">

                            <rect x="3"
                                  y="3"
                                  width="18"
                                  height="18"
                                  rx="2" />

                            <circle cx="8.5"
                                    cy="8.5"
                                    r="1.5" />

                            <polyline points="21 15 16 10 5 21" />

                        </svg>

                    </div>
                }

            </div>


            <!-- INFORMAÇÕES -->
            <div class="detalhes-info">

                @if (!string.IsNullOrEmpty(doce?.CategoryName))
                {
                    <p class="detalhes-categoria">
                        @doce.CategoryName
                    </p>
                }


                <!-- NOME -->
                <h1 class="detalhes-titulo">
                    @doce?.Title
                </h1>


                <!-- DESCRIÇÃO -->
                <p class="detalhes-descricao">
                    @doce?.Description
                </p>


                <!-- PREÇO -->
                <div class="detalhes-preco">
                    @doce?.Preco.ToString("C")
                </div>


                <!-- BOTÕES -->
                <div class="detalhes-acoes">

                    <!-- ADICIONAR AO CARRINHO -->
                    <form asp-controller="Carrinho"
                          asp-action="Adicionar"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@doce?.Id" />

                        <input type="hidden"
                               name="quantidade"
                               value="1" />

                        <button type="submit"
                                class="detalhes-btn detalhes-btn-carrinho">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 width="17"
                                 height="17">

                                <circle cx="9"
                                        cy="21"
                                        r="1" />

                                <circle cx="20"
                                        cy="21"
                                        r="1" />

                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />

                            </svg>

                            Adicionar ao carrinho

                        </button>

                    </form>


                    <!-- VOLTAR PARA PRODUTOS -->
                    <a asp-action="Index"
                       class="detalhes-btn detalhes-btn-voltar">

                        Ver mais produtos

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>