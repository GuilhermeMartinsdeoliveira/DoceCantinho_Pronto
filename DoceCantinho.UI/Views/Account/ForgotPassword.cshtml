@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="page active" id="page-login">

    <div class="auth-wrap">

        <div class="auth-box">

            <div class="auth-header">

                <div class="auth-logo-icon">
                    <svg viewBox="0 0 24 24"
                         fill="currentColor">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                    </svg>
                </div>

                <h1 class="auth-title">
                    Esqueceu sua senha?
                </h1>

                <p class="auth-sub">
                    Informe seu e-mail e enviaremos um link
                    para redefinir sua senha.
                </p>

            </div>

            @if (ViewBag.Mensagem != null)
            {
                <div style="
                    background: #dcfce7;
                    border: 1px solid #86efac;
                    color: #166534;
                    padding: .75rem 1rem;
                    border-radius: .5rem;
                    margin-bottom: 1rem;
                    font-size: .9rem;">

                    @ViewBag.Mensagem

                </div>
            }

            @if (ViewBag.Erro != null)
            {
                <div style="
                    background: #fee2e2;
                    border: 1px solid #fca5a5;
                    color: #991b1b;
                    padding: .75rem 1rem;
                    border-radius: .5rem;
                    margin-bottom: 1rem;
                    font-size: .9rem;">

                    @ViewBag.Erro

                </div>
            }

            <form class="auth-form"
                  asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-group">

                    <label class="form-label">
                        E-mail
                    </label>

                    <input class="form-input"
                           type="email"
                           name="email"
                           required
                           placeholder="seu@email.com" />

                </div>

                <button type="submit"
                        class="form-submit">
                    Enviar link de recuperação
                </button>

                <div class="auth-divider">

                    <div class="line"></div>

                    <span>ou</span>

                    <div class="line"></div>

                </div>

                <p class="auth-footer">

                    <a asp-controller="Account"
                       asp-action="Login">
                        ← Voltar para o login
                    </a>

                </p>

            </form>

        </div>

    </div>

</div>