@model BlogDetailsViewModel
@{
    ViewData["Title"] = Model.Post.Title;
    var post = Model.Post;
}

<style>
    .article-hero {
        position: relative; min-height: 60vh; display: flex; align-items: flex-end;
        overflow: hidden; padding-bottom: 3rem;
    }
    .article-hero-bg { position: absolute; inset: 0; }
    .article-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
    .article-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(44,24,16,.35) 0%, rgba(44,24,16,.92) 100%);
    }
    .article-hero-content { position: relative; z-index: 1; color: var(--primary-fg); }
    .article-breadcrumb { font-size: .82rem; color: rgba(253,246,237,.75); margin-bottom: 1.25rem; }
    .article-breadcrumb a { color: rgba(253,246,237,.85); font-weight: 600; }
    .article-breadcrumb a:hover { color: var(--accent); }
    .article-cat-badge {
        display: inline-block; background: var(--accent); color: var(--accent-fg);
        font-size: .75rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
        padding: .3rem .8rem; border-radius: 100px; margin-bottom: 1.25rem;
    }
    .article-title {
        font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 3.1rem);
        line-height: 1.15; max-width: 900px; margin-bottom: 1.5rem;
    }
    .article-meta { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; font-size: .9rem; color: rgba(253,246,237,.85); }
    .article-meta-avatar {
        width: 40px; height: 40px; border-radius: 50%; background: rgba(253,246,237,.15);
        display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    }
    .article-meta-name { font-weight: 700; color: var(--primary-fg); }
    .article-meta-dot::before { content: '•'; margin: 0 .4rem; opacity: .6; }

    /* Layout do corpo do artigo */
    .article-layout {
        display: grid; grid-template-columns: 240px 1fr; gap: 3.5rem; padding: 3.5rem 0 5rem;
        align-items: start;
    }
    .article-toc {
        position: sticky; top: 90px; background: var(--card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.5rem;
    }
    .article-toc-title { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); margin-bottom: 1rem; }
    .article-toc ol { list-style: none; display: flex; flex-direction: column; gap: .65rem; counter-reset: toc; }
    .article-toc li { counter-increment: toc; font-size: .875rem; }
    .article-toc a {
        color: var(--fg); line-height: 1.4; display: flex; gap: .5rem;
    }
    .article-toc a::before {
        content: counter(toc); flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%;
        background: var(--muted); color: var(--muted-fg); font-size: .7rem; font-weight: 800;
        display: flex; align-items: center; justify-content: center;
    }
    .article-toc a:hover { color: var(--accent); }
    .article-share { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .article-share-title { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); margin-bottom: .8rem; }
    .article-share-links { display: flex; gap: .5rem; }
    .article-share-links a {
        width: 36px; height: 36px; border-radius: 50%; background: var(--muted); color: var(--fg);
        display: flex; align-items: center; justify-content: center; transition: all .2s;
    }
    .article-share-links a:hover { background: var(--primary); color: var(--primary-fg); }
    .article-share-links svg { width: 16px; height: 16px; }

    .article-body { max-width: 760px; }
    .article-body p { color: var(--fg); line-height: 1.85; font-size: 1.05rem; margin-bottom: 1.5rem; }
    .article-body h2 {
        font-family: 'Playfair Display', serif; font-size: 1.75rem; color: var(--primary);
        margin: 2.75rem 0 1.25rem; scroll-margin-top: 90px;
    }
    .article-body h3 {
        font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--primary);
        margin: 2rem 0 1rem;
    }
    .article-body ul { margin: 0 0 1.75rem 0; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: .7rem; }
    .article-body ul li {
        position: relative; padding-left: 1.75rem; color: var(--fg); line-height: 1.65;
    }
    .article-body ul li::before {
        content: ''; position: absolute; left: 0; top: .5rem; width: 9px; height: 9px;
        border-radius: 3px; background: var(--accent);
    }
    .article-quote {
        border-left: 4px solid var(--accent); background: var(--card); border-radius: 0 var(--radius) var(--radius) 0;
        padding: 1.5rem 1.75rem; margin: 2rem 0; font-family: 'Playfair Display', serif;
        font-style: italic; font-size: 1.2rem; color: var(--primary); line-height: 1.6;
    }
    .article-quote cite { display: block; margin-top: .75rem; font-family: 'Nunito', sans-serif; font-style: normal; font-size: .85rem; font-weight: 700; color: var(--muted-fg); }
    .article-tip {
        display: flex; gap: 1rem; background: rgba(212,112,74,.1); border: 1px solid rgba(212,112,74,.25);
        border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 2rem 0;
    }
    .article-tip-icon { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: var(--accent-fg); display: flex; align-items: center; justify-content: center; }
    .article-tip p { margin: 0; color: var(--fg); font-size: .95rem; line-height: 1.6; }
    .article-tip strong { color: var(--primary); display: block; margin-bottom: .2rem; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; }
    .article-figure { margin: 2.25rem 0; }
    .article-figure img { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow-lg); object-fit: cover; max-height: 480px; }
    .article-figure figcaption { text-align: center; color: var(--muted-fg); font-size: .85rem; margin-top: .75rem; }
    .article-hr { border: none; border-top: 1px solid var(--border); margin: 3rem 0; }

    .article-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 2.5rem 0; }
    .article-tag { padding: .4rem .9rem; border-radius: 100px; background: var(--muted); color: var(--muted-fg); font-size: .8rem; font-weight: 700; }

    .article-author-card {
        display: flex; gap: 1.25rem; background: var(--card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 1.75rem; margin-top: 1rem;
    }
    .article-author-avatar {
        flex-shrink: 0; width: 64px; height: 64px; border-radius: 50%; background: var(--muted);
        display: flex; align-items: center; justify-content: center; font-size: 2rem;
    }
    .article-author-card h4 { font-family: 'Playfair Display', serif; color: var(--primary); font-size: 1.15rem; margin-bottom: .15rem; }
    .article-author-card .role { color: var(--accent); font-size: .82rem; font-weight: 700; margin-bottom: .6rem; }
    .article-author-card p.bio { color: var(--muted-fg); font-size: .9rem; line-height: 1.6; margin: 0; }

    /* Relacionados */
    .related-section { background: var(--muted); padding: 4rem 0; }
    .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2.5rem; }
    .related-card {
        background: var(--card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border);
        transition: all .25s;
    }
    .related-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .related-card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; }
    .related-card-body { padding: 1.25rem; }
    .related-card-cat { color: var(--accent); font-size: .72rem; font-weight: 800; text-transform: uppercase; }
    .related-card-title { font-family: 'Playfair Display', serif; font-size: 1.05rem; color: var(--fg); margin-top: .4rem; line-height: 1.3; }

    .article-cta {
        margin-top: 3rem; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        border-radius: 1.25rem; padding: 2.5rem; text-align: center; color: var(--primary-fg);
    }
    .article-cta h3 { font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: .6rem; }
    .article-cta p { color: rgba(253,246,237,.85); margin-bottom: 1.5rem; }

    @@media (max-width: 900px) {
        .article-layout { grid-template-columns: 1fr; }
        .article-toc { position: static; }
        .related-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 600px) {
        .related-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="page active">

    <!-- ─── Hero do artigo ─── -->
    <section class="article-hero">
        <div class="article-hero-bg">
            <img src="@Url.Content(post.CoverImageUrl)" onerror="this.src='https://placehold.co/1200x500?text=Imagem+indisponível'" alt="@post.Title" />
            <img src="@Url.Content(post.AuthorAvatar)" onerror="this.src='https://placehold.co/50x50?text=User'" alt="@post.AuthorName">

        </div>
        <div class="article-hero-overlay"></div>
        <div class="container article-hero-content">
            <p class="article-breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a> /
                <a asp-controller="Blog" asp-action="Index">Blog</a> /
                <a asp-controller="Blog" asp-action="Index" asp-route-categoria="@post.Category">@post.Category</a>
            </p>
            <span class="article-cat-badge">@post.Category</span>
            <h1 class="article-title">@post.Title</h1>
            <div class="article-meta">
                <span class="article-meta-name">@post.AuthorName</span>
                <span class="article-meta-dot"></span>
                <span>@post.PublishedAt.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</span>
                <span class="article-meta-dot"></span>
                <span>@post.ReadingTimeMinutes min de leitura</span>
            </div>
        </div>
    </section>

    <div class="container">
        <div class="article-layout">

            <!-- ─── Sumário (sticky) ─── -->
            <aside class="article-toc">
                @if (post.TableOfContents.Any())
                {
                    <p class="article-toc-title">Neste artigo</p>
                    <ol>
                        @foreach (var item in post.TableOfContents)
                        {
                            <li><a href="#@item.AnchorId">@item.Text</a></li>
                        }
                    </ol>
                }
                <div class="article-share">
                    <p class="article-share-title">Compartilhar</p>
                    <div class="article-share-links">
                        <a href="https://wa.me/?text=@Uri.EscapeDataString(post.Title)" target="_blank" rel="noopener" title="WhatsApp">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4a8.94 8.94 0 0 0-7.75 13.4L3 21l3.72-1.28A8.9 8.9 0 0 0 12.05 21 8.94 8.94 0 0 0 21 12.06a8.86 8.86 0 0 0-3.4-5.74z"/></svg>
                        </a>
                        <a href="mailto:?subject=@Uri.EscapeDataString(post.Title)" title="E-mail">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        </a>
                        <a href="#" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copiado!'); return false;" title="Copiar link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- ─── Corpo do artigo ─── -->
            <article class="article-body">

                @foreach (var block in post.Content)
                {
                    switch (block.Type)
                    {
                        case BlogBlockType.Heading:
                            <h2 id="@BlogPostViewModel.Slugify(block.Text!)">@block.Text</h2>
                            break;
                        case BlogBlockType.SubHeading:
                            <h3>@block.Text</h3>
                            break;
                        case BlogBlockType.Paragraph:
                            <p>@block.Text</p>
                            break;
                        case BlogBlockType.Quote:
                            <blockquote class="article-quote">
                                “@block.Text”
                                @if (!string.IsNullOrWhiteSpace(block.Author))
                                {
                                    <cite>— @block.Author</cite>
                                }
                            </blockquote>
                            break;
                        case BlogBlockType.List:
                            <ul>
                                @foreach (var item in block.Items ?? new List<string>())
                                {
                                    <li>@item</li>
                                }
                            </ul>
                            break;
                        case BlogBlockType.Image:
                            <figure class="article-figure">
                                <img src="@Url.Content(block.ImageUrl)" onerror="this.src='https://placehold.co/800x400?text=Imagem+indisponível'" alt="@block.ImageCaption" loading="lazy" />
                                @if (!string.IsNullOrWhiteSpace(block.ImageCaption))
                                {
                                    <figcaption>@block.ImageCaption</figcaption>
                                }
                            </figure>
                            break;
                        case BlogBlockType.Tip:
                            <div class="article-tip">
                                <div class="article-tip-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 18h6" /><path d="M10 22h4" />
                                        <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1v.2h6v-.2c0-.8.4-1.5 1-2.1A7 7 0 0 0 12 2z" />
                                    </svg>
                                </div>
                                <p><strong>Dica do Doce Cantinho</strong>@block.Text</p>
                            </div>
                            break;
                        case BlogBlockType.Divider:
                            <hr class="article-hr" />
                            break;
                    }
                }

                @if (post.Tags.Any())
                {
                    <div class="article-tags">
                        @foreach (var tag in post.Tags)
                        {
                            <span class="article-tag">#@tag</span>
                        }
                    </div>
                }

                <d<div class="article-author-card">
                    <div class="article-author-avatar">
                        <img src="@Url.Content(post.AuthorAvatar)" onerror="this.src='https://placehold.co/80x80?text=User'" alt="@post.AuthorName" />
                    </div>

                    <h4>@post.AuthorName</h4>
                    <p class="role">@post.AuthorRole</p>
                    <p class="bio">@post.AuthorBio</p>
                </div>

                <div class="article-cta">
                    <h3 class="serif">Ficou com vontade de experimentar?</h3>
                    <p>Confira nossos doces artesanais e faça sua encomenda com quem entende do assunto.</p>
                    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
                        <a asp-controller="Doces" asp-action="Index" class="btn btn-accent">Ver produtos</a>
                        <a asp-controller="Home" asp-action="Contato" class="btn btn-outline" style="border-color:rgba(253,246,237,.6);color:var(--primary-fg)">Falar conosco</a>
                    </div>
                </div>

            </article>
        </div>
    </div>

    @if (Model.RelatedPosts.Any())
    {
        <section class="related-section">
            <div class="container">
                <p class="section-eyebrow" style="text-align:center">Continue lendo</p>
                <h2 class="section-title" style="text-align:center">Você também pode gostar</h2>
                <div class="related-grid">
                    @foreach (var rp in Model.RelatedPosts)
                    {
                        <a asp-action="Details" asp-route-id="@rp.Slug" style="text-decoration:none;color:inherit">
                            <article class="related-card">
                                <img src="@Url.Content(rp.CoverImageUrl)" onerror="this.src='https://placehold.co/600x400?text=Imagem+indisponível'" alt="@rp.Title" loading="lazy" />
                                <div class="related-card-body">
                                    <p class="related-card-cat">@rp.Category</p>
                                    <h3 class="related-card-title">@rp.Title</h3>
                                </div>
                            </article>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

</div>
