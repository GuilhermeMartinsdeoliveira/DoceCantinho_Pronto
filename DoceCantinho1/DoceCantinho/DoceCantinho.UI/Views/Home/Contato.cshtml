@{
    ViewData["Title"] = "Contato";
}

<style>
    .page { padding-top: 2rem; padding-bottom: 4rem; }

    .section { margin-bottom: 4rem; }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-eyebrow {
        font-size: 0.9rem;
        color: var(--muted-fg);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.5rem;
        color: var(--primary);
        margin-bottom: 1rem;
    }

    .section-subtitle {
        font-size: 1.1rem;
        color: var(--muted-fg);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
    }

    

    .contact-form {
        background: var(--card);
        border-radius: var(--radius);
        padding: 2rem;
        border: 1px solid var(--border);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: var(--fg);
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius) - 0.25rem);
        font-family: 'Nunito', sans-serif;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(92, 46, 14, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 120px;
    }

    .form-group button {
        width: 100%;
        padding: 0.85rem;
        background: var(--primary);
        color: var(--primary-fg);
        border: none;
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .form-group button:hover {
        background: #4a2309;
        box-shadow: 0 4px 12px rgba(92, 46, 14, 0.25);
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .info-card {
        background: var(--card);
        border-radius: var(--radius);
        padding: 2rem;
        border: 1px solid var(--border);
        display: flex;
        gap: 1.5rem;
    }

    .info-icon {
        font-size: 0; /* imagens em vez de emoji */
        flex-shrink: 0;
    }
    .info-icon img { width:48px; height:48px; object-fit:contain; display:block; }

    .info-content h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.5rem;
    }

    .info-content p {
        color: var(--muted-fg);
        line-height: 1.6;
        margin-bottom: 0.5rem;
    }

    .info-content a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
    }

    .info-content a:hover {
        color: var(--primary);
        text-decoration: underline;
    }

    .social-links {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .social-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: var(--accent);
        color: white;
        border-radius: 50%;
        text-decoration: none;
        font-size: 1.2rem;
        transition: all 0.2s;
    }

    .social-btn:hover {
        background: var(--primary);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(92, 46, 14, 0.25);
    }

    .map-section {
        border-radius: var(--radius);
        overflow: hidden;
        margin-top: 3rem;
    }

    .map-placeholder {
        width: 100%;
        height: 400px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 3rem;
    }

    .business-hours {
        background: rgba(92, 46, 14, 0.05);
        border-radius: calc(var(--radius) - 0.25rem);
        padding: 1rem;
        margin-top: 1rem;
    }

    .business-hours h4 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 0.75rem;
    }

    .hours-list {
        list-style: none;
        padding: 0;
    }

    .hours-list li {
        display: flex;
        justify-content: space-between;
        color: var(--muted-fg);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .hours-list li span:last-child {
        font-weight: 600;
    }
</style>

<div class="page active">
    <div class="container">
        <!-- Hero Section -->
        <div class="section-header">
            <p class="section-eyebrow">Entre em contato</p>
            <h1 class="section-title">Fale Conosco</h1>
            <p class="section-subtitle">
                Temos prazer em conversar com nossos clientes. Envie uma mensagem ou ligue para nos
                contatar sobre seus pedidos, dúvidas ou sugestões.
            </p>
        </div>

        <!-- Grid de Contato -->
        <div class="contact-grid">
            <!-- Formulário -->
            <div class="contact-form">
                <h3 style="font-size: 1.4rem; color: var(--primary); margin-bottom: 1.5rem; font-family: 'Playfair Display', serif;">
                    Envie uma Mensagem
                </h3>

                <form>
                    <div class="form-group">
                        <label for="nome">Nome *</label>
                        <input type="text" id="nome" name="nome" required placeholder="Seu nome completo" />
                    </div>

                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" required placeholder="seu.email@exemplo.com" />
                    </div>

                    <div class="form-group">
                        <label for="telefone">Telefone</label>
                        <input type="tel" id="telefone" name="telefone" placeholder="(11) 99999-9999" />
                    </div>

                    <div class="form-group">
                        <label for="assunto">Assunto *</label>
                        <input type="text" id="assunto" name="assunto" required placeholder="Sobre o quê você quer falar?" />
                    </div>

                    <div class="form-group">
                        <label for="mensagem">Mensagem *</label>
                        <textarea id="mensagem" name="mensagem" required placeholder="Sua mensagem aqui..."></textarea>
                    </div>

                    <div class="form-group">
                        <button type="submit">Enviar Mensagem</button>
                    </div>
                </form>
            </div>

            <!-- Informações de Contato -->
            <div class="contact-info">
                <!-- Telefone e WhatsApp -->
                <div class="info-card">
                    <div class="info-icon"><img src="https://images.unsplash.com/photo-1518546305922-4b8a3e7b4d1b?w=200&h=200&fit=crop&auto=format" alt="Telefone" loading="lazy" width="48" height="48" onerror="this.onerror=null;this.src='https://via.placeholder.com/48'"/></div>
                    <div class="info-content">
                        <h3>Telefone e WhatsApp</h3>
                        <p>
                            <a href="tel:+5511999999999">(11) 9 9999-9999</a>
                        </p>
                        <p style="font-size: 0.9rem; color: var(--muted-fg);">
                            Atendimento segunda a sábado, das 9h às 18h
                        </p>
                    </div>
                </div>

                <!-- Email -->
                <div class="info-card">
                    <div class="info-icon"><img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=200&h=200&fit=crop&auto=format" alt="Email" loading="lazy" width="48" height="48" onerror="this.onerror=null;this.src='https://via.placeholder.com/48'"/></div>
                    <div class="info-content">
                        <h3>Email</h3>
                        <p>
                            <a href="mailto:contato@docecantinho.com.br">contato@docecantinho.com.br</a>
                        </p>
                        <p style="font-size: 0.9rem; color: var(--muted-fg);">
                            Responderemos em até 24 horas
                        </p>
                    </div>
                </div>

                <!-- Endereço -->
                <div class="info-card">
                    <div class="info-icon"><img src="https://images.unsplash.com/photo-1505691723518-36a2a62ad0a5?w=200&h=200&fit=crop&auto=format" alt="Endereço" loading="lazy" width="48" height="48" onerror="this.onerror=null;this.src='https://via.placeholder.com/48'"/></div>
                    <div class="info-content">
                        <h3>Endereço</h3>
                        <p>Rua das Flores, 123<br>São Paulo - SP, 01234-567</p>
                        <p style="font-size: 0.9rem; color: var(--muted-fg);">
                            Aproveite para visitar nossa loja física!
                        </p>

                        <div class="business-hours">
                            <h4>Horário de Funcionamento</h4>
                            <ul class="hours-list">
                                <li>
                                    <span>Segunda a Sexta</span>
                                    <span>9:00 - 19:00</span>
                                </li>
                                <li>
                                    <span>Sábado</span>
                                    <span>9:00 - 18:00</span>
                                </li>
                                <li>
                                    <span>Domingo e Feriados</span>
                                    <span>Fechado</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Redes Sociais -->
                <div class="info-card">
                    <div class="info-icon"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3658.93790745222!2d-46.436406399999996!3d-23.4987459!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce63e09c957d7d%3A0xcf128208fb85d013!2sR.%20Ten.%20Miguel%20Delia%20-%20Vila%20Rosaria%2C%20S%C3%A3o%20Paulo%20-%20SP%2C%2008021-090!5e0!3m2!1spt-BR!2sbr!4v1787688658619!5m2!1spt-BR!2sbr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
                    <div class="info-content">
                        <h3>Nos Siga</h3>
                        <p style="font-size: 0.9rem; color: var(--muted-fg); margin-bottom: 1rem;">
                            Acompanhe nossas novidades e promoções
                        </p>
                        <div class="social-links">
                            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-btn" title="Instagram">
                                <img src="https://images.unsplash.com/photo-1516139009-1f18b2a7a1b1?w=120&h=120&fit=crop&auto=format" alt="Instagram" width="20" height="20" loading="lazy" onerror="this.onerror=null;this.src='https://via.placeholder.com/20'" />
                            </a>
                            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-btn" title="Facebook">
                                <img src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?w=120&h=120&fit=crop&auto=format" alt="Facebook" width="20" height="20" loading="lazy" onerror="this.onerror=null;this.src='https://via.placeholder.com/20'" />
                            </a>
                            <a href="https://wa.me/5511999999999" target="_blank" rel="noopener noreferrer" class="social-btn" title="WhatsApp">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcToKpSlAIS17imIIRZ53o5i7AhRo2czrJFldIXd0xGqoQ&s=10" alt="WhatsApp" width="20" height="20" loading="lazy" onerror="this.onerror=null;this.src='https://via.placeholder.com/20'" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- CTA Section -->
        <div style="text-align: center; margin-top: 3rem; padding: 2rem; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); border-radius: var(--radius); color: white;">
            <h3 style="font-size: 1.8rem; margin-bottom: 1rem; font-family: 'Playfair Display', serif;">
                Pronto para Encomendar?
            </h3>
            <p style="margin-bottom: 1.5rem; opacity: 0.9;">
                Clique no botão abaixo para começar sua encomenda via WhatsApp
            </p>
            <a href="https://wa.me/5511999999999?text=Olá%20Doce%20Cantinho!%20Gostaria%20de%20fazer%20uma%20encomenda" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 0.85rem 2rem; background: white; color: var(--primary); border-radius: calc(var(--radius) - 0.25rem); text-decoration: none; font-weight: 700; transition: all 0.2s;">
                💬 Abrir WhatsApp
            </a>
        </div>
    </div>
</div>

<script>
    // Simples validação do formulário
        document.querySelector('form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('Obrigado por sua mensagem! Em breve entraremos em contato.');
        this.reset();
    });
</script>
