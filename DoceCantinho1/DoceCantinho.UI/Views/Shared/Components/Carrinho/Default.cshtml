@model int

<a class="cart-btn" asp-controller="Carrinho" asp-action="Index" title="Carrinho" style="position:relative; display:inline-flex; align-items:center; gap:.5rem;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
    </svg>

    @if (Model > 0)
    {
        <span class="cart-badge" style="position:absolute; top:-6px; right:-6px; background:var(--primary); color:var(--primary-fg); border-radius:999px; padding:2px 6px; font-size:.75rem; font-weight:700;">@Model</span>
    }
</a>
