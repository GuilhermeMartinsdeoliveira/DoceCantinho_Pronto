﻿
@using DoceCantinho.Domain.Interfaces
@using Microsoft.AspNetCore.Mvc.Rendering
<link href="~/css/site.css" rel="stylesheet" />
@model DoceCantinho.Application.ViewModels.DoceFormViewModel

<div class="admin-form-page">
    <div class="admin-form-card">

        <p class="admin-form-eyebrow">Área Administrativa</p>
        <h2 class="admin-form-title"><i class="bi bi-cup-hot"></i>Novo Doce</h2>

        <form asp-action="CreateDoce" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="admin-field-error"></div>

            <div class="admin-field">
                <label>Nome</label>
                <input asp-for="Title" type="text" placeholder="Ex: Brigadeiro Gourmet" />
                <span asp-validation-for="Title" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>Descrição</label>
                <textarea asp-for="Description" placeholder="Conte um pouco sobre esse doce..."></textarea>
                <span asp-validation-for="Description" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>Preço</label>
                <input asp-for="Preco" type="number" step="0.01" placeholder="0,00" />
            </div>

            <div class="admin-field">
                <label>Categoria</label>
                <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="CategoryId" class="admin-field-error"></span>
            </div>

            <div class="admin-field" id="imageSourceField">
                <label id="imageSourceLabel">Imagem do doce</label>

                <div class="image-source-toggle" role="radiogroup" aria-labelledby="imageSourceLabel">
                    <input type="radio" name="imageSource" id="imageSourceUrl" value="url" checked />
                    <label for="imageSourceUrl"><i class="bi bi-link-45deg"></i> Usar URL</label>

                    <input type="radio" name="imageSource" id="imageSourceFile" value="file" />
                    <label for="imageSourceFile"><i class="bi bi-upload"></i> Enviar do computador</label>
                </div>

                <div class="image-source-panel" id="imageUrlPanel">
                    <input asp-for="CoverImageUrl" type="text" placeholder="https://..." />
                    <span class="field-hint">Cole o endereço de uma imagem que já esteja na internet.</span>
                </div>

                <div class="image-source-panel" id="imageFilePanel" hidden>
                    <input type="file" name="imageFile" id="imageFileInput" accept="image/*" disabled />
                    <span class="field-hint">JPG, PNG, GIF ou WEBP. A imagem será salva no servidor da loja.</span>
                </div>

                <div class="image-source-preview" id="imagePreview">
                    <img id="imagePreviewImg" alt="Pré-visualização da imagem" />
                </div>
            </div>

            <div class="admin-checkbox-field">
                <input asp-for="IsFeatured" type="checkbox" />
                <label for="IsFeatured"><i class="bi bi-star-fill" style="color:#f5a524;margin-right:.35rem"></i>Destacar este doce na loja</label>
            </div>

            <div class="admin-checkbox-field">
                <input asp-for="IsRecomendado" type="checkbox" />
                <label for="IsRecomendado"><i class="bi bi-hand-thumbs-up-fill" style="color:var(--accent);margin-right:.35rem"></i>Marcar como recomendado</label>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="bi bi-check-lg"></i> Salvar Doce
                </button>
                <a asp-action="Doces" class="admin-btn admin-btn-outline">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>

        </form>
    </div>
</div>

<script>
    (function () {
        var radioUrl = document.getElementById("imageSourceUrl");
        var radioFile = document.getElementById("imageSourceFile");
        var urlPanel = document.getElementById("imageUrlPanel");
        var filePanel = document.getElementById("imageFilePanel");
        var urlInput = urlPanel.querySelector("input");
        var fileInput = document.getElementById("imageFileInput");
        var preview = document.getElementById("imagePreview");
        var previewImg = document.getElementById("imagePreviewImg");
        var objectUrl = null;

        function hidePreview() {
            preview.classList.remove("show");
            previewImg.removeAttribute("src");
        }

        function showPreview(src) {
            previewImg.onerror = hidePreview;
            previewImg.onload = function () { preview.classList.add("show"); };
            previewImg.src = src;
        }

        function refreshPreview() {
            if (objectUrl) {
                URL.revokeObjectURL(objectUrl);
                objectUrl = null;
            }

            if (radioFile.checked) {
                if (fileInput.files && fileInput.files.length > 0) {
                    objectUrl = URL.createObjectURL(fileInput.files[0]);
                    showPreview(objectUrl);
                } else {
                    hidePreview();
                }
                return;
            }

            var url = (urlInput.value || "").trim();
            if (/^https?:\/\//i.test(url) || url.indexOf("/") === 0) {
                showPreview(url);
            } else {
                hidePreview();
            }
        }

        // Só o campo escolhido é enviado: o outro fica desabilitado,
        // então nunca vai URL e arquivo ao mesmo tempo.
        function applySource() {
            var useFile = radioFile.checked;

            urlPanel.hidden = useFile;
            filePanel.hidden = !useFile;
            urlInput.disabled = useFile;
            fileInput.disabled = !useFile;

            refreshPreview();
        }

        radioUrl.addEventListener("change", applySource);
        radioFile.addEventListener("change", applySource);
        urlInput.addEventListener("input", refreshPreview);
        fileInput.addEventListener("change", refreshPreview);

        applySource();
    })();
</script>
