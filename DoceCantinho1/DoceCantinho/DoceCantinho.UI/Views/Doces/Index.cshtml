@model DoceCantinho.Application.ViewModels.DoceListViewModel
@{
    ViewData["Title"] = "Loja";
}

<div class="page active" id="page-loja">
    <div class="container" style="padding-top:2.5rem;padding-bottom:4rem">

        <div style="margin-bottom:2rem">
            <p class="section-eyebrow">Catálogo</p>
            <h1 class="section-title">Nossa Loja</h1>
        </div>

        <!-- Filtro por Categoria -->
        <div class="loja-toolbar">
            <div class="filter-tabs">
                <a class="filter-tab @(!Model.SelectedCategoryId.HasValue ? "active" : "")"
                   asp-action="Index">Todos</a>
                @foreach (var cat in Model.Categories)
                {
                    <a class="filter-tab @(Model.SelectedCategoryId == cat.Id ? "active" : "")"
                       asp-action="Index" asp-route-categoryId="@cat.Id">@cat.Name</a>
                }
            </div>
        </div>

        @if (Model.Doces.Any())
        {
            <div class="products-grid">
                @foreach (var doce in Model.Doces)
                {
                    <div class="product-card">
                        <div class="product-img-wrap">
                            @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                            {
                                <img src="@doce.CoverImageUrl" alt="@doce.Title" class="product-img" />
                            }
                            else
                            {
                                <div class="product-img-placeholder">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                                        <rect x="3" y="3" width="18" height="18" rx="2" />
                                        <circle cx="8.5" cy="8.5" r="1.5" />
                                        <polyline points="21 15 16 10 5 21" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="product-body">
                            @if (!string.IsNullOrEmpty(doce.CategoryName))
                            {
                                <p class="product-cat">@doce.CategoryName</p>
                            }
                            <h3 class="product-name">@doce.Title</h3>
                            <p class="product-desc">@doce.Description</p>
                            <div class="product-footer">
                                <span class="product-preco">@doce.Preco.ToString("C")</span>
                                <a asp-action="Details" asp-route-id="@doce.Id" class="btn btn-accent btn-sm">Ver detalhes</a>

                                <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;margin-left:.5rem">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@doce.Id" />
                                    <input type="hidden" name="quantidade" value="1" />
                                    <button type="submit" class="btn btn-outline btn-sm">Adicionar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="text-align:center;color:var(--muted-fg);padding:5rem 0">
                Nenhum produto encontrado nesta categoria.
            </p>
        }

    </div>
</div>
