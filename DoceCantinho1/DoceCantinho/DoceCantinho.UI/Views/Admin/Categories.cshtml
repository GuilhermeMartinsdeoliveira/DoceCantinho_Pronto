    @using DoceCantinho.Application.DTOs
@model IEnumerable<CategoryDto>

<style>
    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .data-table thead {
        background: var(--primary);
        color: var(--primary-fg);
    }

    .data-table th {
        padding: 1rem;
        text-align: left;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    .data-table td {
        padding: 1rem;
        border-top: 1px solid var(--border);
    }

    .data-table tbody tr:hover {
        background: rgba(92, 46, 14, 0.03);
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    .category-actions {
        display: flex;
        gap: 0.75rem;
    }

    .category-actions a {
        padding: 0.55rem 1rem;
        border-radius: calc(var(--radius) - 0.25rem);
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        transition: all 0.2s ease;
        border: 2px solid;
        text-decoration: none;
        display: inline-block;
    }

    .category-actions a:first-child {
        background: var(--primary);
        color: var(--primary-fg);
        border-color: var(--primary);
    }

    .category-actions a:first-child:hover {
        background: #4a2309;
        border-color: #4a2309;
        box-shadow: 0 4px 12px rgba(92, 46, 14, 0.25);
    }

    .category-actions a:last-child {
        background: transparent;
        color: var(--accent);
        border-color: var(--accent);
    }

    .category-actions a:last-child:hover {
        background: var(--accent);
        color: var(--accent-fg);
        box-shadow: 0 4px 12px rgba(212, 112, 74, 0.25);
    }
</style>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>
                            <div class="category-actions">
                                <a asp-action="EditCategory" asp-route-id="@cat.Id">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:middle;margin-right:6px"><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>Editar
                                </a>
                                <a asp-action="DeleteCategory" asp-route-id="@cat.Id">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" style="vertical-align:middle;margin-right:6px"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>Deletar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
