@model DoceCantinho.Application.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/categorias.css" />

<div class="page active" id="page-home">

    <!-- ─── Hero ─── -->
    <section class="hero">

        <div class="hero-bg">
            <img src="https://images.unsplash.com/photo-1486427944299-d1955d23e34d?w=1600&h=900&fit=crop&auto=format"
                 alt="Confeitaria artesanal" loading="eager" />
            <div class="hero-overlay"></div>
        </div>

        <div class="container hero-content">
            <div>
                <span class="hero-badge">Artesanal • Feito com Amor</span>
                <h1 class="hero-title">Feito com <em>amor</em>,<br>entregue com carinho</h1>
                <p class="hero-desc">
                    Confeitaria artesanal com 12 anos de tradição. Criamos momentos doces
                    para celebrar cada ocasião especial da sua vida.
                </p>
                <div class="hero-btns">
                    <a asp-controller="Doces" asp-action="Index" class="btn btn-accent">
                        Ver Produtos
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </a>
                    <a asp-controller="Home" asp-action="Contato" class="btn btn-ghost">Fazer Encomenda</a>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-n">500+</div>
                    <div class="stat-label">Clientes felizes</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">12</div>
                    <div class="stat-label">Anos de tradição</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">@Model.Categories.Count()</div>
                    <div class="stat-label">Categorias</div>
                </div>
                <div class="stat-card">
                    <div class="stat-n">★ 5.0</div>
                    <div class="stat-label">Avaliação média</div>
                </div>
            </div>
        </div>

    </section>

    <!-- ─── Produtos em Destaque ─── -->
    <section class="section-featured">
        <div class="container">
            <div class="section-header-row">
                <div>
                    <p class="section-eyebrow">Destaques</p>
                    <h2 class="section-title">Nossos Queridinhos</h2>
                </div>
                <a asp-controller="Doces" asp-action="Index" class="see-all-link">
                    Ver todos
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>

            @if (Model.FeaturedDoce.Any())
            {
                <div class="products-grid">
                    @foreach (var doce in Model.FeaturedDoce.Take(4))
                    {
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                                {
                                    <img src="@doce.CoverImageUrl" alt="@doce.Title" class="product-img" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="product-body">
                                <h3 class="product-name">@doce.Title</h3>
                                <div class="product-footer">
                                    <span class="product-price">@doce.Preco.ToString("C")</span>
                                    <button type="button"
                                            class="btn btn-accent btn-sm sweet-view-btn"
                                            data-title="@doce.Title"
                                            data-description="@doce.Description">
                                        Ver
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Model.RecentDoce.Any())
            {
                <!-- Fallback: mostra recentes se não houver destaques cadastrados -->
                <div class="products-grid">
                    @foreach (var doce in Model.RecentDoce.Take(4))
                    {
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                                {
                                    <img src="@doce.CoverImageUrl" alt="@doce.Title" class="product-img" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="product-body">
                                <h3 class="product-name">@doce.Title</h3>
                                <div class="product-footer">
                                    <span class="product-price">@doce.Preco.ToString("C")</span>
                                    <button type="button"
                                            class="btn btn-accent btn-sm sweet-view-btn"
                                            data-title="@doce.Title"
                                            data-description="@doce.Description">
                                        Ver
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="text-align:center;color:var(--muted-fg);padding:3rem 0">
                    Nenhum produto em destaque cadastrado ainda.
                </p>
            }

        </div>
    </section>

    <!-- ─── Categorias ─── -->
    @if (Model.Categories.Any())
    {
        <section class="categories-modern">
            <div class="container">
                <div class="categories-heading">
                    <p class="section-eyebrow">Explore</p>
                    <h2 class="section-title">Nossas Categorias</h2>
                    <p class="categories-subtitle">
                        Encontre o doce perfeito para cada momento.
                    </p>
                </div>

                <div class="categories-modern-grid">
                    @foreach (var cat in Model.Categories)
                    {
                        <a asp-controller="Doces"
                           asp-action="Index"
                           asp-route-categoryId="@cat.Id"
                           class="category-modern-card">

                            <div class="category-modern-icon">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.6"
                                     width="25"
                                     height="25"
                                     aria-hidden="true">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                </svg>
                            </div>

                            <div class="category-modern-info">
                                <h3>@cat.Name</h3>
                                <span>
                                    @cat.DoceCount produto@(cat.DoceCount != 1 ? "s" : "")
                                </span>
                            </div>

                        </a>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ─── Carrossel ─── -->
    <section class="section-carousel">
        <div class="container">
            <div class="carousel-heading">
                <p class="section-eyebrow">Bastidores</p>
                <h2 class="section-title">Nosso Cantinho em Imagens e Vídeo</h2>
                <p class="carousel-subtitle">Conheça um pouco do carinho que colocamos em cada doce.</p>
            </div>

            <div class="dc-carousel" aria-roledescription="carrossel" aria-label="Bastidores do Doce Cantinho">
                <div class="dc-carousel-viewport">
                    <div class="dc-carousel-track">

                        <div class="dc-carousel-slide active">
                            <video class="dc-carousel-media"
                                   muted
                                   playsinline
                                   controls
                                   preload="auto"
                                   poster="https://images.pexels.com/videos/8477942/pictures/preview-0.jpg">
                                <source src="/videos/bolo.mp4" type="video/mp4">
                                Seu navegador não suporta vídeos.
                            </video>
                            <div class="dc-carousel-gradient"></div>
                            <div class="dc-carousel-caption">
                                <h3>Direto da nossa cozinha</h3>
                                <p>Cada detalhe é preparado com carinho para deixar seus momentos ainda mais doces.</p>
                            </div>
                        </div>

                        <div class="dc-carousel-slide">
                            <img class="dc-carousel-media"
                                 src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=1600&h=900&fit=crop&auto=format"
                                 alt="Confeitaria artesanal" loading="lazy">
                            <div class="dc-carousel-gradient"></div>
                            <div class="dc-carousel-caption">
                                <h3>Confeitaria artesanal, feita à mão</h3>
                                <p>Cada doce é preparado com ingredientes selecionados e muito carinho.</p>
                            </div>
                        </div>

                        <div class="dc-carousel-slide">
                            <img class="dc-carousel-media"
                                 src="https://images.unsplash.com/photo-1571115177098-24ec42ed204d?w=1600&h=900&fit=crop&auto=format"
                                 alt="Decoração de doces" loading="lazy">
                            <div class="dc-carousel-gradient"></div>
                            <div class="dc-carousel-caption">
                                <h3>Decoração cuidadosamente pensada</h3>
                                <p>Detalhes que fazem toda a diferença em cada encomenda.</p>
                            </div>
                        </div>

                        <div class="dc-carousel-slide">
                            <img class="dc-carousel-media"
                                 src="https://images.unsplash.com/photo-1517686469429-8bdb88b9f907?w=1600&h=900&fit=crop&auto=format"
                                 alt="Equipe da confeitaria" loading="lazy">
                            <div class="dc-carousel-gradient"></div>
                            <div class="dc-carousel-caption">
                                <h3>Nossa equipe em ação</h3>
                                <p>Confeiteiros apaixonados, trabalhando desde cedo para você.</p>
                            </div>
                        </div>

                    </div>

                    <button type="button" class="dc-carousel-prev" aria-label="Slide anterior">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                    </button>

                    <button type="button" class="dc-carousel-next" aria-label="Próximo slide">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </button>

                    <div class="dc-carousel-dots">
                        <button type="button" class="dc-carousel-dot active" aria-label="Slide 1"></button>
                        <button type="button" class="dc-carousel-dot" aria-label="Slide 2"></button>
                        <button type="button" class="dc-carousel-dot" aria-label="Slide 3"></button>
                        <button type="button" class="dc-carousel-dot" aria-label="Slide 4"></button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
            .carousel-heading {
                text-align: center;
                margin-bottom: 2.5rem;
            }

            .carousel-subtitle {
                margin: 0.6rem auto 0;
                max-width: 680px;
                color: var(--muted-fg);
                line-height: 1.7;
            }

            .dc-carousel {
                width: 100%;
                max-width: 1100px;
                margin: 0 auto;
            }

            .dc-carousel-viewport {
                position: relative;
                width: 100%;
                height: 520px;
                overflow: hidden;
                border-radius: 24px;
                background: #171311;
                box-shadow: 0 25px 70px rgba(0,0,0,.16);
            }

            .dc-carousel-track {
                position: relative;
                width: 100%;
                height: 100%;
            }

            .dc-carousel-slide {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity .55s ease;
            }

                .dc-carousel-slide.active {
                    opacity: 1;
                    visibility: visible;
                    pointer-events: auto;
                }

            .dc-carousel-media {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                background: #171311;
            }

            .dc-carousel-gradient {
                position: absolute;
                inset: 0;
                z-index: 2;
                pointer-events: none;
                background: linear-gradient(to top,rgba(0,0,0,.78) 0%,rgba(0,0,0,.35) 45%,rgba(0,0,0,0) 75%);
            }

            .dc-carousel-caption {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 4;
                padding: 40px 70px 58px;
                color: white;
            }

                .dc-carousel-caption h3 {
                    margin: 0 0 8px;
                    font-family: 'Playfair Display',serif;
                    font-size: 2rem;
                    font-weight: 700;
                }

                .dc-carousel-caption p {
                    max-width: 680px;
                    margin: 0;
                    color: rgba(255,255,255,.9);
                    font-size: .98rem;
                    line-height: 1.7;
                }

            .dc-carousel-prev, .dc-carousel-next {
                position: absolute;
                top: 50%;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 50px;
                height: 50px;
                padding: 0;
                border: 1px solid rgba(255,255,255,.35);
                border-radius: 50%;
                background: rgba(0,0,0,.38);
                color: white;
                cursor: pointer;
                transform: translateY(-50%);
                backdrop-filter: blur(8px);
                transition: .25s ease;
            }

            .dc-carousel-prev {
                left: 20px;
            }

            .dc-carousel-next {
                right: 20px;
            }

                .dc-carousel-prev:hover, .dc-carousel-next:hover {
                    background: rgba(0,0,0,.65);
                    transform: translateY(-50%) scale(1.08);
                }

                .dc-carousel-prev svg, .dc-carousel-next svg {
                    width: 23px;
                    height: 23px;
                }

            .dc-carousel-dots {
                position: absolute;
                left: 50%;
                bottom: 20px;
                z-index: 12;
                display: flex;
                gap: 8px;
                transform: translateX(-50%);
            }

            .dc-carousel-dot {
                width: 9px;
                height: 9px;
                padding: 0;
                border: 0;
                border-radius: 50%;
                background: rgba(255,255,255,.45);
                cursor: pointer;
                transition: .25s ease;
            }

                .dc-carousel-dot.active {
                    width: 27px;
                    border-radius: 10px;
                    background: white;
                }
            @@media(max-width:800px) {
                .dc-carousel-viewport {
                    height: 430px;
                }

                .dc-carousel-caption {
                    padding: 30px 55px 55px;
                }

                    .dc-carousel-caption h3 {
                        font-size: 1.55rem;
                    }

                    .dc-carousel-caption p {
                        font-size: .9rem;
                    }
            }
            @@media(max-width:600px) {
                .dc-carousel-viewport {
                    height: 380px;
                    border-radius: 18px;
                }

                .dc-carousel-caption {
                    padding: 25px 25px 50px;
                }

                    .dc-carousel-caption h3 {
                        font-size: 1.3rem;
                    }

                    .dc-carousel-caption p {
                        font-size: .84rem;
                        line-height: 1.5;
                    }

                .dc-carousel-prev, .dc-carousel-next {
                    width: 40px;
                    height: 40px;
                }

                .dc-carousel-prev {
                    left: 10px;
                }

                .dc-carousel-next {
                    right: 10px;
                }
            }
    </style>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const carousel = document.querySelector(".dc-carousel");
                if (!carousel) return;

                const slides = Array.from(carousel.querySelectorAll(".dc-carousel-slide"));
                const dots = Array.from(carousel.querySelectorAll(".dc-carousel-dot"));
                const prev = carousel.querySelector(".dc-carousel-prev");
                const next = carousel.querySelector(".dc-carousel-next");
                let current = 0;
                let timer = null;

                function showSlide(index) {
                    if (index < 0) index = slides.length - 1;
                    if (index >= slides.length) index = 0;
                    current = index;

                    slides.forEach((slide, i) => slide.classList.toggle("active", i === current));
                    dots.forEach((dot, i) => dot.classList.toggle("active", i === current));

                    slides.forEach(slide => {
                        const video = slide.querySelector("video");
                        if (video) video.pause();
                    });

                    const currentVideo = slides[current].querySelector("video");
                    if (currentVideo) {
                        currentVideo.currentTime = 0;
                        currentVideo.play().catch(() => { });
                    }
                }

                function nextSlide() { showSlide(current + 1); restartTimer(); }
                function previousSlide() { showSlide(current - 1); restartTimer(); }

                next?.addEventListener("click", nextSlide);
                prev?.addEventListener("click", previousSlide);

                dots.forEach((dot, index) => {
                    dot.addEventListener("click", () => {
                        showSlide(index);
                        restartTimer();
                    });
                });

                slides.forEach(slide => {
                    const video = slide.querySelector("video");
                    if (video) {
                        video.addEventListener("ended", nextSlide);
                        video.addEventListener("error", () => setTimeout(nextSlide, 1000));
                    }
                });

                function startTimer() {
                    clearInterval(timer);
                    timer = setInterval(() => {
                        const video = slides[current].querySelector("video");
                        if (video && !video.ended) return;
                        nextSlide();
                    }, 6000);
                }

                function restartTimer() {
                    clearInterval(timer);
                    startTimer();
                }

                carousel.addEventListener("mouseenter", () => clearInterval(timer));
                carousel.addEventListener("mouseleave", startTimer);

                let touchStart = 0;
                let touchEnd = 0;

                carousel.addEventListener("touchstart", e => {
                    touchStart = e.changedTouches[0].screenX;
                }, { passive: true });

                carousel.addEventListener("touchend", e => {
                    touchEnd = e.changedTouches[0].screenX;
                    const distance = touchEnd - touchStart;
                    if (Math.abs(distance) < 50) return;
                    if (distance < 0) nextSlide();
                    else previousSlide();
                }, { passive: true });

                showSlide(0);
                startTimer();
            });
    </script>

    <!-- ─── Avaliações e Depoimentos ─── -->
    <section class="section-testimonials" id="avaliacoes">
        <div class="container">
            <div class="reviews-heading">
                <div>
                    <p class="section-eyebrow">Experiências reais</p>
                    <h2 class="section-title light">Avalie os doces e o nosso site</h2>
                    <p class="reviews-intro">Sua opinião ajuda o DoceCantinho a ficar cada vez melhor.</p>
                </div>
                <div class="rating-summary" aria-label="Avaliação média 5 de 5">
                    <strong>5,0</strong>
                    <span class="rating-stars">★★★★★</span>
                    <small>clientes satisfeitos</small>
                </div>
            </div>

            <div class="reviews-layout">
                <div class="testimonials-grid">
                    <article class="testimonial-card">
                        <div class="testimonial-stars">★★★★★</div>
                        <p class="testimonial-text">“O bolo de casamento foi simplesmente perfeito. Todos os convidados adoraram!”</p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">A</div>
                            <div>
                                <p class="testimonial-name">Ana Oliveira</p>
                                <p class="testimonial-role">Cliente verificada</p>
                            </div>
                        </div>
                    </article>

                    <article class="testimonial-card">
                        <div class="testimonial-stars">★★★★★</div>
                        <p class="testimonial-text">“Encomendei para o aniversário da minha filha e ela ficou encantada. Qualidade incrível!”</p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">M</div>
                            <div>
                                <p class="testimonial-name">Maria Santos</p>
                                <p class="testimonial-role">Cliente verificada</p>
                            </div>
                        </div>
                    </article>

                    <article class="testimonial-card">
                        <div class="testimonial-stars">★★★★★</div>
                        <p class="testimonial-text">“Os macarons são os melhores que já comi. O site também é fácil de navegar. Recomendo!”</p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">C</div>
                            <div>
                                <p class="testimonial-name">Carlos Mendes</p>
                                <p class="testimonial-role">Cliente verificado</p>
                            </div>
                        </div>
                    </article>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form class="review-form" id="review-form">
                        <div class="review-form-header">
                            <p class="section-eyebrow">Deixe seu depoimento</p>
                            <h3>Como foi sua experiência?</h3>
                            <p>Conte o que achou dos doces e da experiência de navegar pelo site.</p>
                        </div>

                        <div class="form-grid2">
                            <div class="review-field">
                                <label for="review-name">Seu nome</label>
                                <input id="review-name" name="name" type="text" maxlength="60" placeholder="Ex.: Juliana Souza" required>
                            </div>
                            <div class="review-field">
                                <label for="review-email">E-mail</label>
                                <input id="review-email" name="email" type="email" placeholder="seu@email.com" required>
                            </div>
                        </div>

                        <div class="review-rating-grid">
                            <fieldset class="rating-fieldset">
                                <legend>Avaliação dos doces</legend>
                                <div class="star-picker" data-rating="sweet">
                                    <button type="button" data-value="1">★</button>
                                    <button type="button" data-value="2">★</button>
                                    <button type="button" data-value="3">★</button>
                                    <button type="button" data-value="4">★</button>
                                    <button type="button" data-value="5">★</button>
                                </div>
                                <input type="hidden" name="sweetRating" id="sweet-rating" value="5">
                            </fieldset>

                            <fieldset class="rating-fieldset">
                                <legend>Avaliação do site</legend>
                                <div class="star-picker" data-rating="site">
                                    <button type="button" data-value="1">★</button>
                                    <button type="button" data-value="2">★</button>
                                    <button type="button" data-value="3">★</button>
                                    <button type="button" data-value="4">★</button>
                                    <button type="button" data-value="5">★</button>
                                </div>
                                <input type="hidden" name="siteRating" id="site-rating" value="5">
                            </fieldset>
                        </div>

                        <div class="review-field">
                            <label for="review-message">Seu depoimento</label>
                            <textarea id="review-message" name="message" rows="4" maxlength="500" required></textarea>
                            <small class="field-hint">Até 500 caracteres.</small>
                        </div>

                        <label class="review-check">
                            <input type="checkbox" name="permission" required>
                            <span>Autorizo a exibição deste depoimento no site.</span>
                        </label>

                        <button type="submit" class="btn btn-accent review-submit">
                            Enviar
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                        <p class="review-success" id="review-success">Obrigado! Sua avaliação foi registrada neste navegador.</p>
                    </form>
                }
                else
                {
                    <div class="review-form review-locked">
