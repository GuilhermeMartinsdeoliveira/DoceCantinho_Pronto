@model DoceCantinho.UI.ViewModels.BlogAdminViewModel

@{
    ViewData["Title"] = "Editar artigo";
}

<style>
    .blog-form-container {
        max-width: 950px;
        margin: 40px auto;
        padding: 0 20px 60px;
    }

    .blog-form-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 30px;
        box-shadow: var(--shadow);
    }

        .blog-form-card h1 {
            font-family: 'Playfair Display', serif;
            margin-top: 0;
            color: var(--fg);
        }

        .blog-form-card > p {
            color: var(--muted-fg);
            margin-bottom: 30px;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            font-weight: 700;
            color: var(--fg);
            margin-bottom: 7px;
        }

    .form-control-blog {
        box-sizing: border-box;
        width: 100%;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--fg);
        border-radius: 10px;
        padding: 12px 14px;
        font-family: inherit;
        font-size: 15px;
        outline: none;
    }

        .form-control-blog:focus {
            border-color: var(--primary);
        }

    textarea.form-control-blog {
        resize: vertical;
    }

    .editor-ajuda {
        background: var(--muted);
        border-radius: 10px;
        padding: 15px;
        margin-top: 10px;
        font-size: 13px;
        color: var(--muted-fg);
        line-height: 1.8;
    }

        .editor-ajuda code {
            background: var(--card);
            padding: 3px 6px;
            border-radius: 5px;
            color: var(--primary);
        }

    .check-area {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
        padding: 15px 0;
    }

        .check-area label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            color: var(--fg);
        }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
        border-top: 1px solid var(--border);
        padding-top: 25px;
    }

    .btn-salvar {
        border: 0;
        background: var(--primary);
        color: var(--primary-fg);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 800;
        cursor: pointer;
    }

    .btn-cancelar {
        background: var(--muted);
        color: var(--fg);
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
    }

    .validation-summary-errors {
        background: #fee2e2;
        color: #991b1b;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .text-danger {
        display: block;
        color: #dc2626;
        margin-top: 5px;
        font-size: 13px;
    }

    .imagem-atual {
        width: 260px;
        max-height: 180px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--border);
        display: block;
        margin-top: 10px;
    }

    @@media(max-width:700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full {
            grid-column: auto;
        }
    }
</style>

<div class="blog-form-container">

    ```
    <div class="blog-form-card">

        <h1>Editar artigo</h1>

        <p>
            Altere as informações do artigo e salve as alterações.
        </p>

        <form asp-controller="Admin"
              asp-action="EditBlogPost"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors"></div>

            <div class="form-grid">

                <!-- TÍTULO -->

                <div class="form-group full">

                    <label asp-for="Title"></label>

                    <input asp-for="Title"
                           class="form-control-blog"
                           placeholder="Título do artigo" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>


                <!-- RESUMO -->

                <div class="form-group full">

                    <label asp-for="Excerpt"></label>

                    <textarea asp-for="Excerpt"
                              rows="3"
                              class="form-control-blog"
                              placeholder="Resumo do artigo"></textarea>

                    <span asp-validation-for="Excerpt"
                          class="text-danger"></span>

                </div>


                <!-- CATEGORIA -->

                <div class="form-group">

                    <label asp-for="Category"></label>

                    <input asp-for="Category"
                           class="form-control-blog"
                           placeholder="Ex: Receitas" />

                    <span asp-validation-for="Category"
                          class="text-danger"></span>

                </div>


                <!-- TAGS -->

                <div class="form-group">

                    <label asp-for="Tags"></label>

                    <input asp-for="Tags"
                           class="form-control-blog"
                           placeholder="brigadeiro, chocolate, receitas" />

                    <small>
                        Separe as tags por vírgula.
                    </small>

                </div>


                <!-- URL DA CAPA -->

                <div class="form-group">

                    <label asp-for="CoverImageUrl">
                        URL da imagem da capa
                    </label>

                    <input asp-for="CoverImageUrl"
                           class="form-control-blog"
                           placeholder="https://..." />

                </div>


                <!-- UPLOAD CAPA -->

                <div class="form-group">

                    <label>
                        Trocar imagem da capa
                    </label>

                    <input type="file"
                           name="coverFile"
                           class="form-control-blog"
                           accept=".jpg,.jpeg,.png,.webp,image/*" />

                </div>


                <!-- IMAGEM ATUAL -->
                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <div class="form-group full">

                        <label>
                            Imagem atual
                        </label>

                        <img src="@Model.CoverImageUrl"
                             class="imagem-atual"
                             alt="@Model.Title" />

                    </div>
                }


                <!-- CONTEÚDO -->

                <div class="form-group full">

                    <label asp-for="Content"></label>

                    <textarea asp-for="Content"
                              rows="18"
                              class="form-control-blog"
                              placeholder="Conteúdo do artigo"></textarea>

                    <span asp-validation-for="Content"
                          class="text-danger"></span>

                    <div class="editor-ajuda">

                        <strong>
                            Formatação disponível:
                        </strong>

                        <br />

                        <code>## Título</code>

                        <br />

                        <code>### Subtítulo</code>

                        <br />

                        <code>- Item da lista</code>

                        <br />

                        <code>&gt; Citação</code>

                        <br />

                        <code>[DICA] Texto da dica</code>

                        <br />

                        <code>[IMAGEM] https://site.com/imagem.jpg</code>

                        <br />

                        <code>---</code>

                        cria uma divisão.

                    </div>

                </div>


                <!-- AUTOR -->

                <div class="form-group">

                    <label asp-for="AuthorName"></label>

                    <input asp-for="AuthorName"
                           class="form-control-blog"
                           placeholder="Nome do autor" />

                    <span asp-validation-for="AuthorName"
                          class="text-danger"></span>

                </div>


                <!-- CARGO -->

                <div class="form-group">

                    <label asp-for="AuthorRole"></label>

                    <input asp-for="AuthorRole"
                           class="form-control-blog"
                           placeholder="Ex: Confeiteira-chefe" />

                </div>


                <!-- AVATAR URL -->

                <div class="form-group">

                    <label asp-for="AuthorAvatar">
                        URL da foto do autor
                    </label>

                    <input asp-for="AuthorAvatar"
                           class="form-control-blog"
                           placeholder="/imagens/autores/confeiteira.jpg" />

                </div>


                <!-- AVATAR UPLOAD -->

                <div class="form-group">

                    <label>
                        Trocar foto do autor
                    </label>

                    <input type="file"
                           name="authorFile"
                           class="form-control-blog"
                           accept=".jpg,.jpeg,.png,.webp,image/*" />

                </div>


                <!-- BIO -->

                <div class="form-group full">

                    <label asp-for="AuthorBio"></label>

                    <textarea asp-for="AuthorBio"
                              rows="3"
                              class="form-control-blog"
                              placeholder="Biografia do autor"></textarea>

                </div>


                <!-- DATA -->

                <div class="form-group">

                    <label asp-for="PublishedAt"></label>

                    <input asp-for="PublishedAt"
                           type="date"
                           class="form-control-blog" />

                </div>

            </div>


            <!-- OPÇÕES -->

            <div class="check-area">

                <label>

                    <input asp-for="IsPublished" />

                    Publicado

                </label>


                <label>

                    <input asp-for="Featured" />

                    Artigo em destaque

                </label>

            </div>


            <!-- BOTÕES -->

            <div class="form-actions">

                <button type="submit"
                        class="btn-salvar">

                    Salvar alterações

                </button>


                <a asp-controller="Admin"
                   asp-action="Blog"
                   class="btn-cancelar">

                    Cancelar

                </a>

            </div>

        </form>

    </div>
    ```

</div>

@section Scripts {

    ```
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
    ```

}
