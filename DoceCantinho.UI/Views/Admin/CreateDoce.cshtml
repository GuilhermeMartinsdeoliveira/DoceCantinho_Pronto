﻿
@using DoceCantinho.Domain.Interfaces
@using Microsoft.AspNetCore.Mvc.Rendering
<link href="~/css/site.css" rel="stylesheet" />
@model DoceCantinho.Application.ViewModels.DoceFormViewModel

<div class="admin-form-page">
    <div class="admin-form-card">

        <p class="admin-form-eyebrow">Área Administrativa</p>
        <h2 class="admin-form-title"><i class="bi bi-cup-hot"></i>Novo Doce</h2>

        <form asp-action="CreateDoce" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="admin-field-error"></div>

            <div class="admin-field">
                <label>Nome</label>
                <input asp-for="Title" type="text" placeholder="Ex: Brigadeiro Gourmet" />
                <span asp-validation-for="Title" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>Descrição</label>
                <textarea asp-for="Description" placeholder="Conte um pouco sobre esse doce..."></textarea>
                <span asp-validation-for="Description" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>Preço</label>
                <input asp-for="Preco" type="number" step="0.01" placeholder="0,00" />
            </div>

            <div class="admin-field">
                <label>Categoria</label>
                <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="CategoryId" class="admin-field-error"></span>
            </div>

            <div class="admin-field">
                <label>Imagem (URL)</label>
                <input asp-for="CoverImageUrl" type="text" placeholder="https://..." />
            </div>

            <div class="admin-field">
                <label>Imagem (arquivo)</label>
                <input type="file" name="imageFile" accept="image/*" />
                <span class="field-hint">Enviar um arquivo substitui a URL informada acima.</span>
            </div>

            <div class="admin-checkbox-field">
                <input asp-for="IsFeatured" type="checkbox" />
                <label for="IsFeatured"><i class="bi bi-star-fill" style="color:#f5a524;margin-right:.35rem"></i>Destacar este doce na loja</label>
            </div>

            <div class="admin-checkbox-field">
                <input asp-for="IsRecomendado" type="checkbox" />
                <label for="IsRecomendado"><i class="bi bi-hand-thumbs-up-fill" style="color:var(--accent);margin-right:.35rem"></i>Marcar como recomendado</label>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn admin-btn-primary">
                    <i class="bi bi-check-lg"></i> Salvar Doce
                </button>
                <a asp-action="Doces" class="admin-btn admin-btn-outline">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>

        </form>
    </div>
</div>

<script src="~/js/site.js"></script>