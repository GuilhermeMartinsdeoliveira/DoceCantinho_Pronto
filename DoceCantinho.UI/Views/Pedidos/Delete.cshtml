@using DoceCantinho.Application.DTOs
@model PedidoDto

@{
    ViewData["Title"] = "Excluir Pedido";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <span class="delete-label">
            EXCLUSÃO DE PEDIDO
        </span>

        <h1>
            Excluir pedido?
        </h1>

        <p class="delete-description">
            Você está prestes a excluir permanentemente
            este pedido. Essa ação não poderá ser desfeita.
        </p>


        <div class="delete-order">

            <div>

                <span>
                    Pedido
                </span>

                <strong>
                    #@Model.Id.ToString("D4")
                </strong>

            </div>

            <div class="delete-status">

                @Model.Status

            </div>

        </div>


        <div class="delete-info">

            <div>

                <span>
                    Cliente
                </span>

                <strong>
                    @Model.NomeCliente
                </strong>

            </div>


            <div>

                <span>
                    Data
                </span>

                <strong>
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </strong>

            </div>


            <div>

                <span>
                    Itens
                </span>

                <strong>
                    @Model.Items.Count
                </strong>

            </div>


            <div>

                <span>
                    Total
                </span>

                <strong class="delete-total">
                    R$ @Model.Total.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="delete-actions">

            <form method="post"
                  action="@Url.Action("DeleteConfirmed", "Pedidos", new { id = Model.Id })">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="delete-confirm">

                    <i class="bi bi-trash3"></i>

                    Excluir permanentemente

                </button>

            </form>


            <a href="@Url.Action("Index", "Pedidos")"
               class="delete-cancel">

                <i class="bi bi-arrow-left"></i>

                Voltar aos pedidos

            </a>

        </div>

    </div>

</div>


<style>

    .delete-page {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 20px;
    }


    .delete-card {
        width: 100%;
        max-width: 620px;
        background: #FFF9F3;
        border: 1px solid #EBDDD1;
        border-radius: 25px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 15px 45px rgba(70,35,15,.10);
    }


    .delete-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        border-radius: 22px;
        background: #FDECEC;
        color: #D64545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }


    .delete-label {
        color: #D64545;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }


    .delete-card h1 {
        color: #3D2314;
        font-family: 'Playfair Display', serif;
        font-size: 32px;
        margin: 8px 0;
    }


    .delete-description {
        color: #8A6555;
        font-size: 14px;
        max-width: 470px;
        margin: 0 auto 25px;
    }


    .delete-order {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #F5EAE1;
        border-radius: 15px;
        padding: 17px 20px;
        margin-bottom: 15px;
        text-align: left;
    }


        .delete-order span {
            display: block;
            color: #98786A;
            font-size: 12px;
        }


        .delete-order strong {
            color: #3D2314;
            font-size: 20px;
        }


    .delete-status {
        background: #FDECEC;
        color: #D64545;
        border-radius: 100px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 800;
    }


    .delete-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 1px solid #EBDDD1;
        border-radius: 15px;
        margin-bottom: 25px;
        overflow: hidden;
    }


        .delete-info div {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #EBDDD1;
        }


            .delete-info div:nth-child(odd) {
                border-right: 1px solid #EBDDD1;
            }


        .delete-info span {
            display: block;
            color: #98786A;
            font-size: 11px;
        }


        .delete-info strong {
            color: #4B3022;
            font-size: 14px;
        }


    .delete-total {
        color: #C96B45 !important;
        font-size: 18px !important;
    }


    .delete-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


    .delete-confirm {
        width: 100%;
        border: none;
        background: #D64545;
        color: white;
        padding: 14px;
        border-radius: 11px;
        font-weight: 800;
        cursor: pointer;
    }


        .delete-confirm:hover {
            background: #B93232;
        }


    .delete-cancel {
        color: #684838;
        border: 1px solid #D9C8BB;
        padding: 13px;
        border-radius: 11px;
        font-weight: 700;
        text-decoration: none;
    }


        .delete-cancel:hover {
            background: #F4E8DE;
            color: #3D2314;
        }


    @@media(max-width:600px) {

        .delete-card {
            padding: 25px 18px;
        }

        .delete-info {
            grid-template-columns: 1fr;
        }

            .delete-info div:nth-child(odd) {
                border-right: none;
            }
    }

</style>