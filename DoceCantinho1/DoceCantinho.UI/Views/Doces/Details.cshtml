@model DoceCantinho.Application.ViewModels.DoceDetailsViewModel
@{
    ViewData["Title"] = Model?.Doce?.Title ?? "Detalhes";
    var doce = Model?.Doce;
}

<div class="page active">
    <div class="container" style="padding-top:3rem;padding-bottom:4rem">

        <a asp-action="Index" style="display:inline-flex;align-items:center;gap:.4rem;color:var(--muted-fg);margin-bottom:2rem;font-size:.9rem;text-decoration:none">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
            </svg>
            Voltar à loja
        </a>

        <div class="details-grid">
            <div>
                @if (!string.IsNullOrEmpty(doce?.CoverImageUrl))
                {
                    <img src="@doce.CoverImageUrl" alt="@doce.Title" class="details-img" />
                }
                else
                {
                    <div class="details-img-placeholder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="80" height="80">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                        </svg>
                    </div>
                }
            </div>

            <div>
                @if (!string.IsNullOrEmpty(doce?.CategoryName))
                {
                    <p class="product-cat" style="margin-bottom:.5rem">@doce.CategoryName</p>
                }
                <h1 class="section-title" style="margin-bottom:1rem">@doce?.Title</h1>
                <p style="color:var(--muted-fg);line-height:1.7;margin-bottom:1.5rem">@doce?.Description</p>

                <div class="details-price">@doce?.Preco.ToString("C")</div>

                <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
                    <form asp-controller="Carrinho" asp-action="Adicionar" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@doce?.Id" />
                        <button type="submit" class="btn btn-accent">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                            </svg>
                            Adicionar ao carrinho
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline">Ver mais produtos</a>
                </div>
            </div>
        </div>

        <!-- Produtos Relacionados -->
        @if (Model?.RelatedDoce != null && Model.RelatedDoce.Any())
        {
            <div style="margin-top:4rem">
                <p class="section-eyebrow">Veja também</p>
                <h2 class="section-title" style="margin-bottom:2rem">Produtos Relacionados</h2>
                <div class="products-grid">
                    @foreach (var rel in Model.RelatedDoce)
                    {
                        <div class="product-card">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(rel.CoverImageUrl))
                                {
                                    <img src="@rel.CoverImageUrl" alt="@rel.Title" class="product-img" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="product-body">
                                <h3 class="product-name">@rel.Title</h3>
                                <div class="product-footer">
                                    <span class="product-price">@rel.Preco.ToString("C")</span>
                                    <a asp-action="Details" asp-route-id="@rel.Id" class="btn btn-accent btn-sm">Ver</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
</div>
