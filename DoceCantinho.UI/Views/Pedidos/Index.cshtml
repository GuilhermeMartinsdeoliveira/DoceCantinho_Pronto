@using DoceCantinho.Application.DTOs
@model List<PedidoDto>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Pedidos";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;

    (string bg, string fg, string icon) StatusInfo(string status) => status switch
    {
        "Pago" => ("#E8F8EF", "#159447", "bi-check-circle-fill"),
        "Entregue" => ("#E8F8EF", "#159447", "bi-bag-check-fill"),
        "Em Preparo" => ("#FFF4D8", "#B87900", "bi-hourglass-split"),
        "Saiu para Entrega" => ("#E8F0FF", "#3D70D6", "bi-truck"),
        "Cancelado" => ("#FDECEC", "#D64545", "bi-x-circle-fill"),
        _ => ("#FFF4D8", "#B87900", "bi-clock-fill")
    };
}

<div class="pedidos-page">

    <!-- CABEÇALHO -->
    <div class="pedidos-header">

        <div>
            <div class="pedidos-eyebrow">
                <i class="bi bi-receipt"></i>
                PAINEL DE PEDIDOS
            </div>

            <h1>
                @(isAdmin ? "Gerenciar Pedidos" : "Meus Pedidos")
            </h1>

            <p>
                @(isAdmin
                    ? "Gerencie todos os pedidos do Doce Cantinho em um só lugar."
                    : "Acompanhe seus pedidos e veja todos os detalhes.")
            </p>
        </div>

        @if (isAdmin)
{
    <a asp-controller="Pedidos"
       asp-action="NovoPedido"
       class="pedido-btn pedido-btn-primary">

        <i class="bi bi-plus-lg"></i>
        Novo Pedido

    </a>
}
     

    </div>


    <!-- MENSAGENS -->
    @if (TempData["Success"] != null)
    {
        <div class="pedido-alert pedido-alert-success">
            <i class="bi bi-check-circle-fill"></i>

            <span>@TempData["Success"]</span>

            <button type="button"
                    onclick="this.parentElement.remove()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="pedido-alert pedido-alert-danger">
            <i class="bi bi-exclamation-circle-fill"></i>

            <span>@TempData["Error"]</span>

            <button type="button"
                    onclick="this.parentElement.remove()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }


    <!-- CARDS DE RESUMO -->
    @if (isAdmin)
    {
        var totalPedidos = Model?.Count ?? 0;
        var pendentes = Model?.Count(x => x.Status == "Pendente") ?? 0;
        var andamento = Model?.Count(x =>
            x.Status == "Em Preparo" ||
            x.Status == "Saiu para Entrega") ?? 0;
        var valorTotal = Model?.Sum(x => x.Total) ?? 0;

        <div class="pedido-stats">

            <div class="pedido-stat-card">
                <div class="pedido-stat-icon pedido-stat-brown">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <strong>@totalPedidos</strong>
                    <span>Pedidos no total</span>
                </div>
            </div>

            <div class="pedido-stat-card">
                <div class="pedido-stat-icon pedido-stat-yellow">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <strong>@pendentes</strong>
                    <span>Pendentes</span>
                </div>
            </div>

            <div class="pedido-stat-card">
                <div class="pedido-stat-icon pedido-stat-blue">
                    <i class="bi bi-truck"></i>
                </div>

                <div>
                    <strong>@andamento</strong>
                    <span>Em andamento</span>
                </div>
            </div>

            <div class="pedido-stat-card">
                <div class="pedido-stat-icon pedido-stat-green">
                    <i class="bi bi-currency-dollar"></i>
                </div>

                <div>
                    <strong>R$ @valorTotal.ToString("N2")</strong>
                    <span>Valor total</span>
                </div>
            </div>

        </div>
    }


    <!-- FILTROS -->
    @if (isAdmin)
    {
        <div class="pedido-filters">

            <button class="pedido-filter active"
                    data-filter="todos">
                Todos
            </button>

            <button class="pedido-filter"
                    data-filter="Pendente">
                Pendentes
            </button>

            <button class="pedido-filter"
                    data-filter="Em Preparo">
                Em preparo
            </button>

            <button class="pedido-filter"
                    data-filter="Saiu para Entrega">
                Em entrega
            </button>

            <button class="pedido-filter"
                    data-filter="Pago">
                Pagos
            </button>

            <button class="pedido-filter"
                    data-filter="Cancelado">
                Cancelados
            </button>

        </div>
    }


    <!-- PEDIDOS -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="pedido-empty">

            <div class="pedido-empty-icon">
                <i class="bi bi-bag-x"></i>
            </div>

            <h2>Nenhum pedido encontrado</h2>

            <p>
                Os pedidos aparecerão aqui quando forem cadastrados.
            </p>

        </div>
    }
    else
    {
        <div class="pedido-list">

            @foreach (var pedido in Model)
            {
                var (bg, fg, icon) = StatusInfo(pedido.Status);

                var podeCancelar = isAdmin
                    ? pedido.Status != "Cancelado" && pedido.Status != "Entregue"
                    : pedido.Status == "Pendente";

                <article class="pedido-modern-card"
                         data-status="@pedido.Status">

                    <!-- PARTE SUPERIOR -->
                    <div class="pedido-card-top">

                        <div class="pedido-number">

                            <div class="pedido-status-icon"
                                 style="background:@bg;color:@fg">

                                <i class="bi @icon"></i>

                            </div>

                            <div>

                                <div class="pedido-number-row">

                                    <strong>
                                        #@pedido.Id.ToString("D4")
                                    </strong>

                                    <span class="pedido-status"
                                          style="background:@bg;color:@fg">

                                        @pedido.Status

                                    </span>

                                </div>

                                <p>
                                    <i class="bi bi-person"></i>
                                    @pedido.NomeCliente
                                </p>

                                <small>
                                    <i class="bi bi-calendar3"></i>
                                    @pedido.CreatedAt.ToString("dd/MM/yyyy HH:mm")

                                    @if (isAdmin)
                                    {
                                        <span>
                                            · Usuário: @pedido.UserId
                                        </span>
                                    }
                                </small>

                            </div>

                        </div>

                        <div class="pedido-total">

                            <span>Total do pedido</span>

                            <strong>
                                R$ @pedido.Total.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <!-- PARTE INFERIOR -->
                    <div class="pedido-card-bottom">

                        <div class="pedido-info">

                            <span>
                                <i class="bi bi-basket2"></i>
                                @pedido.Items.Count item(s)
                            </span>

                            <span>
                                <i class="bi bi-credit-card"></i>
                                @pedido.PaymentMethod
                            </span>

                        </div>


                        <div class="pedido-actions">

                            <!-- DETALHES -->
                            <a href="@Url.Action("Details", "Pedidos", new { id = pedido.Id })"
                               class="pedido-action pedido-action-details">

                                <i class="bi bi-eye"></i>
                                Detalhes

                            </a>


                            @if (isAdmin)
                            {
                                <!-- EDITAR -->
                                <a href="@Url.Action("Edit", "Pedidos", new { id = pedido.Id })"
                                   class="pedido-action pedido-action-edit">

                                    <i class="bi bi-pencil"></i>
                                    Editar

                                </a>


                                <!-- EXCLUIR -->
                                <a href="@Url.Action("Delete", "Pedidos", new { id = pedido.Id })"
                                   class="pedido-action pedido-action-delete">

                                    <i class="bi bi-trash3"></i>
                                    Excluir

                                </a>
                            }


                            @if (podeCancelar)
                            {
                                <!-- CANCELAR -->
                                <form method="post"
                                      action="@Url.Action("Cancel", "Pedidos", new { id = pedido.Id })"
                                      class="pedido-cancel-form"
                                      onsubmit="return confirmarCancelamento();">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="pedido-action pedido-action-cancel">

                                        <i class="bi bi-x-circle"></i>
                                        Cancelar

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>


<script>

    function confirmarCancelamento() {

        return confirm(
            "Tem certeza que deseja cancelar este pedido?"
        );

    }


    document.addEventListener("DOMContentLoaded", function () {

        const filtros =
            document.querySelectorAll(".pedido-filter");

        const pedidos =
            document.querySelectorAll(".pedido-modern-card");


        filtros.forEach(function (filtro) {

            filtro.addEventListener("click", function () {

                filtros.forEach(function (item) {
                    item.classList.remove("active");
                });

                this.classList.add("active");

                const status =
                    this.dataset.filter;


                pedidos.forEach(function (pedido) {

                    if (
                        status === "todos" ||
                        pedido.dataset.status === status
                    ) {

                        pedido.style.display = "";

                    }
                    else {

                        pedido.style.display = "none";

                    }

                });

            });

        });

    });

</script>


<style>

    /* ================================
       PÁGINA
       ================================ */

    .pedidos-page {

        max-width: 1150px;
        margin: 0 auto;
        padding: 50px 25px 80px;

    }


    /* ================================
       CABEÇALHO
       ================================ */

    .pedidos-header {

        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 35px;

    }

    .pedidos-eyebrow {

        color: #C96B45;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 8px;

    }

    .pedidos-eyebrow i {

        margin-right: 5px;

    }

    .pedidos-header h1 {

        margin: 0;
        color: #3D2314;
        font-family: 'Playfair Display', serif;
        font-size: 42px;
        font-weight: 700;

    }

    .pedidos-header p {

        margin: 8px 0 0;
        color: #8A6555;
        font-size: 16px;

    }


    /* ================================
       BOTÃO NOVO PEDIDO
       ================================ */

    .pedido-btn {

        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 13px 20px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;

    }

    .pedido-btn-primary {

        color: white;
        background: #3D2314;
        box-shadow: 0 8px 20px rgba(61,35,20,.15);

    }

    .pedido-btn-primary:hover {

        color: white;
        background: #C96B45;
        transform: translateY(-2px);

    }


    /* ================================
       ALERTAS
       ================================ */

    .pedido-alert {

        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 25px;

    }

    .pedido-alert button {

        margin-left: auto;
        border: none;
        background: transparent;

    }

    .pedido-alert-success {

        background: #E8F8EF;
        color: #16834A;

    }

    .pedido-alert-danger {

        background: #FDECEC;
        color: #C83E3E;

    }


    /* ================================
       STATS
       ================================ */

    .pedido-stats {

        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;

    }

    .pedido-stat-card {

        background: #FFF9F3;
        border: 1px solid #EBDDD1;
        border-radius: 18px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 20px rgba(70,35,15,.05);

    }

    .pedido-stat-icon {

        width: 52px;
        height: 52px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;

    }

    .pedido-stat-brown {

        background: #F0E8E0;
        color: #5C2E0E;

    }

    .pedido-stat-yellow {

        background: #FFF1C8;
        color: #B87900;

    }

    .pedido-stat-blue {

        background: #E4EDFF;
        color: #3D70D6;

    }

    .pedido-stat-green {

        background: #DCF8E7;
        color: #159447;

    }

    .pedido-stat-card strong {

        display: block;
        color: #3D2314;
        font-size: 20px;

    }

    .pedido-stat-card span {

        color: #947668;
        font-size: 13px;

    }


    /* ================================
       FILTROS
       ================================ */

    .pedido-filters {

        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 25px;

    }

    .pedido-filter {

        border: 1px solid #E2D2C5;
        background: #FFF9F3;
        color: #684838;
        padding: 9px 17px;
        border-radius: 100px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;

    }

    .pedido-filter:hover {

        border-color: #C96B45;
        color: #C96B45;

    }

    .pedido-filter.active {

        background: #3D2314;
        color: white;
        border-color: #3D2314;

    }


    /* ================================
       CARD DO PEDIDO
       ================================ */

    .pedido-list {

        display: flex;
        flex-direction: column;
        gap: 16px;

    }

    .pedido-modern-card {

        background: #FFF9F3;
        border: 1px solid #EBDDD1;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 6px 25px rgba(70,35,15,.055);
        transition: .25s;

    }

    .pedido-modern-card:hover {

        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(70,35,15,.10);

    }

    .pedido-card-top {

        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        padding: 25px;

    }

    .pedido-number {

        display: flex;
        align-items: center;
        gap: 16px;

    }

    .pedido-status-icon {

        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;

    }

    .pedido-number-row {

        display: flex;
        align-items: center;
        gap: 10px;

    }

    .pedido-number-row strong {

        color: #3D2314;
        font-size: 18px;

    }

    .pedido-status {

        padding: 5px 10px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 800;

    }

    .pedido-number p {

        margin: 5px 0 2px;
        color: #755443;
        font-size: 14px;

    }

    .pedido-number small {

        color: #A08070;
        font-size: 12px;

    }

    .pedido-total {

        text-align: right;

    }

    .pedido-total span {

        display: block;
        color: #9A7B6B;
        font-size: 12px;

    }

    .pedido-total strong {

        display: block;
        color: #C96B45;
        font-size: 23px;
        margin-top: 3px;

    }


    /* ================================
       PARTE INFERIOR
       ================================ */

    .pedido-card-bottom {

        border-top: 1px solid #EBDDD1;
        padding: 17px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;

    }

    .pedido-info {

        display: flex;
        gap: 18px;
        color: #8C6B5B;
        font-size: 13px;

    }

    .pedido-actions {

        display: flex;
        gap: 7px;
        flex-wrap: wrap;

    }

    .pedido-action {

        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 13px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        background: transparent;
        transition: .2s;

    }

    .pedido-action-details {

        color: #3D2314;
        border: 1px solid #3D2314;

    }

    .pedido-action-details:hover {

        color: white;
        background: #3D2314;

    }

    .pedido-action-edit {

        color: #C96B45;
        border: 1px solid #C96B45;

    }

    .pedido-action-edit:hover {

        color: white;
        background: #C96B45;

    }

    .pedido-action-delete,
    .pedido-action-cancel {

        color: #D64545;
        border: 1px solid #E07A7A;

    }

    .pedido-action-delete:hover,
    .pedido-action-cancel:hover {

        color: white;
        background: #D64545;

    }

    .pedido-cancel-form {

        margin: 0;

    }


    /* ================================
       VAZIO
       ================================ */

    .pedido-empty {

        text-align: center;
        padding: 70px 20px;
        background: #FFF9F3;
        border: 1px solid #EBDDD1;
        border-radius: 20px;

    }

    .pedido-empty-icon {

        width: 70px;
        height: 70px;
        margin: auto;
        border-radius: 50%;
        background: #F4E8DE;
        color: #C96B45;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;

    }

    .pedido-empty h2 {

        color: #3D2314;
        font-family: 'Playfair Display', serif;
        margin-top: 18px;

    }

    .pedido-empty p {

        color: #947668;

    }


    /* ================================
       RESPONSIVO
       ================================ */

    @@media (max-width: 900px) {

        .pedido-stats {

            grid-template-columns: repeat(2, 1fr);

        }

    }

    @@media (max-width: 650px) {

        .pedidos-page {

            padding: 30px 15px 60px;

        }

        .pedidos-header {

            align-items: flex-start;
            flex-direction: column;

        }

        .pedidos-header h1 {

            font-size: 34px;

        }

        .pedido-stats {

            grid-template-columns: 1fr;

        }

        .pedido-card-top {

            align-items: flex-start;
            flex-direction: column;

        }

        .pedido-total {

            text-align: left;

        }

        .pedido-card-bottom {

            align-items: flex-start;
            flex-direction: column;

        }

        .pedido-info {

            flex-direction: column;
            gap: 5px;

        }

        .pedido-actions {

            width: 100%;

        }

        .pedido-action {

            flex: 1;

            justify-content: center;

        }

    }

</style>