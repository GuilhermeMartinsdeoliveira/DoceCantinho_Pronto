@model DoceCantinho.Application.ViewModels.DoceListViewModel

@{
    ViewData["Title"] = "Loja";
}

<div class="page active" id="page-loja">

    <div class="container loja-container">

        <!-- CABEÇALHO -->
        <div class="loja-header">

            <p class="section-eyebrow">
                Catálogo
            </p>

            <h1 class="section-title">
                Nossa Loja
            </h1>

            <p class="loja-subtitle">
                Pequenos doces, grandes momentos
            </p>

        </div>


        <!-- PRODUTOS -->
        @if (Model.Doces.Any())
        {
            <div class="products-grid">

                @* PRODUTOS EM DESTAQUE APARECEM PRIMEIRO *@
                @foreach (var doce in Model.Doces.OrderByDescending(x => x.IsFeatured))
                {
                    <div class="product-card">

                        <!-- IMAGEM -->
                        <div class="product-img-wrap">

                            @if (doce.IsFeatured)
                            {
                                <span class="product-featured-badge"
                                      title="Produto em destaque">

                                    <i class="bi bi-star-fill"></i>

                                </span>
                            }


                            @if (!string.IsNullOrEmpty(doce.CoverImageUrl))
                            {
                                <img src="@doce.CoverImageUrl"
                                     alt="@doce.Title"
                                     class="product-img" />
                            }
                            else
                            {
                                <div class="product-img-placeholder">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.5"
                                         width="48"
                                         height="48">

                                        <rect x="3"
                                              y="3"
                                              width="18"
                                              height="18"
                                              rx="2" />

                                        <circle cx="8.5"
                                                cy="8.5"
                                                r="1.5" />

                                        <polyline points="21 15 16 10 5 21" />

                                    </svg>

                                </div>
                            }

                        </div>


                        <!-- INFORMAÇÕES DO PRODUTO -->
                        <div class="product-body">

                            <!-- NOME DO DOCE -->
                            <h3 class="product-name">
                                @doce.Title
                            </h3>


                            <!-- ÁREA DE COMPRA -->
                            <div class="loja-buy-area">

                                <!-- PREÇO -->
                                <div class="loja-price">
                                    @doce.Preco.ToString("C")
                                </div>


                                <!-- BOTÕES -->
                                <div class="loja-buttons">

                                    <!-- VER DETALHES -->
                                    <a asp-action="Details"
                                       asp-route-id="@doce.Id"
                                       class="loja-btn loja-btn-details">

                                        Ver detalhes

                                    </a>


                                    <!-- ADICIONAR AO CARRINHO -->
                                    <form asp-controller="Carrinho"
                                          asp-action="Adicionar"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@doce.Id" />

                                        <input type="hidden"
                                               name="quantidade"
                                               value="1" />

                                        <button type="submit"
                                                class="loja-btn loja-btn-add">

                                            Adicionar

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- NENHUM PRODUTO -->
            <p class="empty-products">
                Nenhum produto encontrado nesta categoria.
            </p>
        }

    </div>

</div>