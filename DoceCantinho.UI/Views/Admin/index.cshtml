@model DoceCantinho.Application.ViewModels.DashboardViewModel
@using DoceCantinho.Domain.Entities
@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = null; // Admin tem seu próprio layout completo

    var pedidosRecentes = ViewData["PedidosHojeAdmin"] as List<Pedido> ?? new List<Pedido>();
    var pedidosAdmin = ViewData["PedidosAdmin"] as List<Pedido> ?? new List<Pedido>();

    string StatusCssClass(string s) => s switch
    {
        "Pago" or "Entregue" => "status-entregue",
        "Em Preparo" or "Saiu para Entrega" => "status-preparo",
        "Cancelado" => "status-cancelado",
        _ => "status-pendente"
    };

    string ResumoProdutos(Pedido p) => p.Items != null && p.Items.Any()
        ? string.Join(", ", p.Items.Select(i => i.Nome).Take(2)) + (p.Items.Count > 2 ? "…" : "")
        : "—";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — DoceCantinho</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Admin topnav -->
    <div id="admin-topnav">
        <div class="admin-topnav-brand">
            <div class="admin-topnav-brand-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
            </div>
            <span class="admin-topnav-name">DoceCantinho</span>
            <span class="admin-badge">Admin</span>
        </div>
        <a class="admin-back-btn" asp-controller="Home" asp-action="Index">← Voltar ao site</a>
    </div>

    <!-- Admin layout -->
    <div class="page active" id="page-admin">
        <div class="admin-layout">

            <!-- Sidebar -->
            <aside class="admin-sidebar">
                <div class="admin-user">
                    <div class="admin-avatar">@User.Identity?.Name?.Substring(0,1).ToUpper()</div>
                    <div>
                        <div class="admin-user-name">@User.Identity?.Name</div>
                        <div class="admin-user-role">Administradora</div>
                    </div>
                </div>

                <nav class="admin-nav">
                    <button class="admin-nav-btn active" id="anb-dashboard" onclick="adminTab('dashboard')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" />
                        </svg>Dashboard
                    </button>
                    <button class="admin-nav-btn" id="anb-pedidos" onclick="adminTab('pedidos')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>Pedidos
                    </button>
                    <button class="admin-nav-btn" id="anb-produtos" onclick="adminTab('produtos')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        </svg>Produtos
                    </button>
                    <button class="admin-nav-btn" id="anb-categorias" onclick="adminTab('categorias')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" />
                            <line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" />
                            <line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" />
                        </svg>Categorias
                    </button>
                    <a asp-controller="Admin"
                       asp-action="Blog"
                       class="admin-nav-btn">
                        <span>▣</span>
                        <span>Blog</span>
                    </a>
                    <button class="admin-nav-btn" id="anb-clientes" onclick="adminTab('clientes')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>Clientes
                    </button>
                </nav>

                <form asp-controller="Account" asp-action="Logout" method="post" class="admin-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Sair
                    </button>
                </form>
            </aside>

            <!-- Main content -->
            <main class="admin-main">

                <!-- Dashboard Tab -->
                <div class="admin-tab active" id="atab-dashboard">
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-icon" style="background:#dcfce7">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" width="17" height="17">
                                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" />
                                </svg>
                            </div>
                            <div class="kpi-val">@Html.Raw(ViewData["MonthlyRevenue"] ?? "R$ 0,00")</div>
                            <div class="kpi-label">Receita Mensal</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-icon" style="background:#dbeafe">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#1d4ed8" stroke-width="2" width="17" height="17">
                                    <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                                </svg>
                            </div>
                            <div class="kpi-val">@ViewData["PedidosHojeCount"]</div>
                            <div class="kpi-label">Pedidos Hoje</div>
                            @{
                                var variacaoPedidosHoje = (int)(ViewData["PedidosHojeVariacao"] ?? 0);
                            }
                            @if (variacaoPedidosHoje > 0)
                            {
                                <div class="kpi-change">+@variacaoPedidosHoje vs. ontem</div>
                            }
                            else if (variacaoPedidosHoje < 0)
                            {
                                <div class="kpi-change" style="background:#fee2e2;color:#b91c1c">@variacaoPedidosHoje vs. ontem</div>
                            }
                            else
                            {
                                <div class="kpi-change">sem variação</div>
                            }
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-icon" style="background:#fef9c3">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#a16207" stroke-width="2" width="17" height="17">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                </svg>
                            </div>
                            <div class="kpi-val">@ViewData["ProdutosAtivos"]</div>
                            <div class="kpi-label">Produtos Ativos</div>
                        </div>
                        <div class="kpi-card">
                            <div class="kpi-icon" style="background:#f3e8ff">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" width="17" height="17">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                </svg>
                            </div>
                            <div class="kpi-val">@ViewData["ClientesAtivos"]</div>
                            <div class="kpi-label">Clientes</div>
                        </div>
                    </div>

                    <div class="admin-section">
                        <h2 class="admin-section-title">Pedidos Recentes</h2>
                        <div class="table-card">
                            <div style="overflow-x:auto">
                                <table class="data-table">
                                    <thead>
                                        <tr><th>Pedido</th><th>Cliente</th><th>Produto</th><th>Valor</th><th>Status</th><th>Data</th></tr>
                                    </thead>
                                    <tbody>
                                        @if (!pedidosRecentes.Any())
                                        {
                                            <tr><td colspan="6" style="text-align:center;color:var(--muted-fg);padding:2rem">Nenhum pedido hoje.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var p in pedidosRecentes)
                                            {
                                                <tr>
                                                    <td class="mono">#@p.Id.ToString("D4")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(p.NomeCliente) ? "Cliente não informado" : p.NomeCliente)</td>
                                                    <td style="color:var(--muted-fg)">@ResumoProdutos(p)</td>
                                                    <td><strong>R$ @p.Total.ToString("F2")</strong></td>
                                                    <td><span class="status-badge @StatusCssClass(p.Status)">@p.Status</span></td>
                                                    <td style="color:var(--muted-fg);font-size:0.78rem">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pedidos Tab -->
                <div class="admin-tab" id="atab-pedidos">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
                        <h2 class="admin-section-title" style="margin:0">Pedidos</h2>
                    </div>
                    <div class="table-card">
                        <div class="table-header"><h3>Todos os Pedidos</h3></div>
                        <div style="overflow-x:auto">
                            <table class="data-table">
                                <thead>
                                    <tr><th>Pedido</th><th>Cliente</th><th>Produto</th><th>Valor</th><th>Status</th><th>Data</th><th>Ações</th></tr>
                                </thead>
                                <tbody>
                                    @if (!pedidosAdmin.Any())
                                    {
                                        <tr><td colspan="7" style="text-align:center;color:var(--muted-fg);padding:2rem">Nenhum pedido encontrado.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var p in pedidosAdmin)
                                        {
                                            <tr>
                                                <td class="mono">#@p.Id.ToString("D4")</td>
                                                <td>@(string.IsNullOrWhiteSpace(p.NomeCliente) ? "Cliente não informado" : p.NomeCliente)</td>
                                                <td style="color:var(--muted-fg)">@ResumoProdutos(p)</td>
                                                <td><strong>R$ @p.Total.ToString("F2")</strong></td>
                                                <td><span class="status-badge @StatusCssClass(p.Status)">@p.Status</span></td>
                                                <td style="color:var(--muted-fg);font-size:0.78rem">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>
                                                    <div style="display:flex;gap:4px">
                                                        <a class="order-action-btn" title="Ver detalhes"
                                                           asp-controller="Pedidos" asp-action="Details" asp-route-id="@p.Id">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                                        </a>
                                                        <a class="order-action-btn" title="Editar pedido / status"
                                                           asp-controller="Pedidos" asp-action="Edit" asp-route-id="@p.Id">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                                        </a>
                                                        <a class="order-action-btn danger" title="Excluir"
                                                           asp-controller="Pedidos" asp-action="Delete" asp-route-id="@p.Id">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /></svg>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


                <!-- Produtos Tab -->
                <div class="admin-tab" id="atab-produtos">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
                        <h2 class="admin-section-title" style="margin:0">Produtos</h2>
                        <a asp-controller="Admin" asp-action="CreateDoce" class="btn btn-primary btn-sm">+ Novo Produto</a>
                    </div>
                    <partial name="Doces" model="Model.RecentDoces" />
                </div>

                <!-- Categorias Tab -->
                <div class="admin-tab" id="atab-categorias">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
                        <h2 class="admin-section-title" style="margin:0">Categorias</h2>
                        <a asp-controller="Admin" asp-action="CreateCategory" class="btn btn-primary btn-sm">+ Nova Categoria</a>
                    </div>
                    <partial name="Categories" model="Model.Categories" />
                </div>

                <!-- Clientes Tab -->
                <div class="admin-tab" id="atab-clientes">
                    <h2 class="admin-section-title">Clientes</h2>
                    <partial name="Clientes" />
                </div>

            </main>
        </div>
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar</a>

    <script src="~/js/site.js" asp-append_version="true"></script>
</body>
</html>
