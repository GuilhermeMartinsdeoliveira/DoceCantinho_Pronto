                <!-- =========================================================
     MODAL - DESCRIÇÃO DO DOCE
     ========================================================= -->

                <div id="sweet-description-modal" class="sweet-modal" aria-hidden="true">

                    <div class="sweet-modal-content" role="dialog" aria-modal="true" aria-labelledby="sweet-modal-title">

                        <button type="button"
                                class="sweet-modal-close"
                                id="sweet-modal-close"
                                aria-label="Fechar">
                            &times;
                        </button>

                        <span class="sweet-modal-label">DOCE CANTINHO</span>

                        <h2 id="sweet-modal-title"></h2>

                        <p id="sweet-modal-description"></p>

                        <button type="button"
                                class="btn btn-accent"
                                id="sweet-modal-close-bottom">
                            Fechar
                        </button>

                    </div>

                </div>



                <script>
                                    document.addEventListener("DOMContentLoaded", function() {

                                        const modal = document.getElementById("sweet-description-modal");
                                        const title = document.getElementById("sweet-modal-title");
                                        const description = document.getElementById("sweet-modal-description");
                                        const closeTop = document.getElementById("sweet-modal-close");
                                        const closeBottom = document.getElementById("sweet-modal-close-bottom");

                                        if (!modal || !title || !description) {
                                            return;
                                        }

                                        function openSweetModal(button) {

                                            title.textContent = button.dataset.title || "Doce";
                                            description.textContent = button.dataset.description || "";

                                            modal.classList.add("show");
                                            modal.setAttribute("aria-hidden", "false");
                                            document.body.style.overflow = "hidden";
                                        }

                                        function closeSweetModal() {

                                            modal.classList.remove("show");
                                            modal.setAttribute("aria-hidden", "true");
                                            document.body.style.overflow = "";
                                        }

                                        document.querySelectorAll(".sweet-view-btn").forEach(function(button) {

                                            button.addEventListener("click", function() {
                                                openSweetModal(button);
                                            });

                                        });

                                        if (closeTop) {
                                            closeTop.addEventListener("click", closeSweetModal);
                                        }

                                        if (closeBottom) {
                                            closeBottom.addEventListener("click", closeSweetModal);
                                        }

                                        modal.addEventListener("click", function(event) {

                                            if (event.target === modal) {
                                                closeSweetModal();
                                            }

                                        });

                                        document.addEventListener("keydown", function(event) {

                                            if (event.key === "Escape" && modal.classList.contains("show")) {
                                                closeSweetModal();
                                            }

                                        });

                                    });
                </script>


            </div>
