    <!-- =========================================================
         AOS - ANIMAÇÕES
         ========================================================= -->

    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>



    <!-- =========================================================
         ACESSIBILIDADE + AOS
         ========================================================= -->

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {


                    /* =================================================
                       BOTÕES DE FONTE
                       ================================================= */

                    const increaseButton =
                        document.getElementById("fontIncrease");

                    const decreaseButton =
                        document.getElementById("fontDecrease");

                    const resetButton =
                        document.getElementById("fontReset");


                    let fontSize = 100;


                    /* =================================================
                       RECUPERAR TAMANHO SALVO
                       ================================================= */

                    const savedFontSize =
                        localStorage.getItem(
                            "doceCantinhoFontSize"
                        );


                    if (savedFontSize) {

                        fontSize =
                            parseInt(savedFontSize);

                        document.documentElement.style.fontSize =
                            fontSize + "%";
                    }



                    /* =================================================
                       AUMENTAR FONTE
                       ================================================= */

                    if (increaseButton) {

                        increaseButton.addEventListener(
                            "click",
                            function () {

                                if (fontSize < 130) {

                                    fontSize += 10;

                                    document.documentElement.style.fontSize =
                                        fontSize + "%";


                                    localStorage.setItem(
                                        "doceCantinhoFontSize",
                                        fontSize
                                    );

                                }

                            }
                        );

                    }



                    /* =================================================
                       DIMINUIR FONTE
                       ================================================= */

                    if (decreaseButton) {

                        decreaseButton.addEventListener(
                            "click",
                            function () {

                                if (fontSize > 80) {

                                    fontSize -= 10;

                                    document.documentElement.style.fontSize =
                                        fontSize + "%";


                                    localStorage.setItem(
                                        "doceCantinhoFontSize",
                                        fontSize
                                    );

                                }

                            }
                        );

                    }



                    /* =================================================
                       RESETAR FONTE
                       ================================================= */

                    if (resetButton) {

                        resetButton.addEventListener(
                            "click",
                            function () {

                                fontSize = 100;


                                document.documentElement.style.fontSize =
                                    "100%";


                                localStorage.setItem(
                                    "doceCantinhoFontSize",
                                    fontSize
                                );

                            }
                        );

                    }



                    /* =================================================
                       AOS
                       ================================================= */

                    if (typeof AOS !== "undefined") {

                        AOS.init({

                            duration: 800,

                            once: true,

                            offset: 80,

                            easing: "ease-out-cubic"

                        });

                    }

                }
            );

    </script>



    <!-- =========================================================
         SCRIPTS DAS PÁGINAS
         ========================================================= -->
    @await RenderSectionAsync(
            "Scripts",
            required: false
        )

