<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoceCantinho</title>
    <script>
            (function () {
                const savedTheme = localStorage.getItem('docecantinho-theme');

                const systemDark =
                    window.matchMedia &&
                    window.matchMedia('(prefers-color-scheme: dark)').matches;

                const theme =
                    savedTheme ||
                    (systemDark ? 'dark' : 'light');

                document.documentElement.setAttribute('data-theme', theme);
            })();
    </script>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoceCantinho.UI.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ─── Nav ─── -->
    <nav id="nav">
        <div class="container nav-inner">

            <a class="nav-logo" asp-controller="Home" asp-action="Index">
                <div class="nav-logo-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                    </svg>
                </div>
                <span class="nav-logo-text">DoceCantinho</span>
            </a>

            <div class="nav-links">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doces" ? "active" : "")"
                   asp-controller="Doces" asp-action="Index">Loja</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Servicos" ? "active" : "")"
                   asp-controller="Home" asp-action="Servicos">Serviços</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Sobre" ? "active" : "")"
                   asp-controller="Home" asp-action="Sobre">Sobre Nós</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "active" : "")"
                   asp-controller="Blog" asp-action="Index">Blog</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contato" ? "active" : "")"
                   asp-controller="Home" asp-action="Contato">Contato</a>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedidos" ? "active" : "")"
                       asp-controller="Pedidos" asp-action="Index">Meus Pedidos</a>
                }
            </div>

            <div class="nav-actions">
                @await Component.InvokeAsync("Carrinho")

                <!-- Botão Dark / Light Mode -->
                <button type="button"
                        id="theme-toggle"
                        class="theme-toggle"
                        onclick="toggleTheme()"
                        aria-label="Alternar tema"
                        title="Alternar tema">

                    <!-- Sol -->
                    <svg id="theme-icon-sun"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="12" cy="12" r="4"></circle>

                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>

                        <path d="M4.93 4.93l1.41 1.41"></path>
                        <path d="M17.66 17.66l1.41 1.41"></path>

                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>

                        <path d="M4.93 19.07l1.41-1.41"></path>
                        <path d="M17.66 6.34l1.41-1.41"></path>
                    </svg>

                    <!-- Lua -->
                    <svg id="theme-icon-moon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <path d="M21 12.79A9 9 0 1 1 11.21 3
                            7 7 0 0 0 21 12.79z">
                        </path>

                    </svg>

                    <span id="theme-text">Escuro</span>
                </button>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn-login">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                            Sair
                        </button>
                    </form>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn-login" asp-controller="Admin" asp-action="Index" style="margin-left:.5rem">
                            Admin
                        </a>
                    }
                }
                else
                {
                    <a class="btn-login" asp-controller="Account" asp-action="Login">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <polyline points="10 17 15 12 10 7" />
                            <line x1="15" y1="12" x2="3" y2="12" />
                        </svg>
                        Entrar
                    </a>
                }

                <button class="hamburger" id="hamburger" onclick="toggleMenu()">
                    <svg id="ham-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="mobile-menu container" id="mobile-menu">
            <a class="mobile-link" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>Home
            </a>
            <a class="mobile-link" asp-controller="Doces" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>Loja
            </a>
            <a class="mobile-link" asp-controller="Home" asp-action="Servicos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                    <path d="M4.93 4.93a10 10 0 0 0 0 14.14" />
                </svg>Serviços
            </a>
            <a class="mobile-link" asp-controller="Home" asp-action="Sobre">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>Sobre Nós
            </a>
            <a class="mobile-link" asp-controller="Blog" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>Blog
            </a>
            <a class="mobile-link" asp-controller="Home" asp-action="Contato">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>Contato
            </a>
            <a class="mobile-link" asp-controller="Account" asp-action="Login">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                </svg>Entrar
            </a>
        </div>
    </nav>

    <!-- ─── Conteúdo principal ─── -->
    <main style="padding-top: 70px;">
        @RenderBody()
    </main>

    <!-- ─── Footer ─── -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">
                        <div class="footer-brand-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                            </svg>
                        </div>
                        <span class="footer-brand-name serif">DoceCantinho</span>
                    </div>
                    <p class="footer-desc">Confeitaria artesanal com amor e tradição desde 2012.</p>
                </div>
                <div>
                    <p class="footer-col-title">Navegação</p>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Doces" asp-action="Index">Loja</a></li>
                        <li><a asp-controller="Home" asp-action="Servicos">Serviços</a></li>
                        <li><a asp-controller="Home" asp-action="Sobre">Sobre Nós</a></li>
                        <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <p class="footer-col-title">Conta</p>
                    <ul class="footer-links">
                        <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Cadastro</a></li>
                    </ul>
                </div>
                <div>
                    <p class="footer-col-title">Contato</p>
                    <ul class="footer-contact">
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                <circle cx="12" cy="10" r="3" />
                            </svg>Rua das Flores, 342 — Centro
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.5 2 2 0 0 1 3.6 1.32h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.04z" />
                            </svg>(11) 94567-8901
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                <polyline points="22,6 12,13 2,6" />
                            </svg>ola@docecantinho.com.br
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">© 2026 DoceCantinho. Todos os direitos reservados.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/carousel.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
