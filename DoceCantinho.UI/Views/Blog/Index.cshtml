@model BlogIndexViewModel
@{
    ViewData["Title"] = "Blog";
}

<style>
    .blog-hero {
        position: relative;
        overflow: hidden;
        padding: 5.5rem 0 4rem;
        text-align: center;
        color: var(--primary-fg);
        background: radial-gradient(circle at 15% 20%, rgba(212,112,74,.55), transparent 45%),
                    radial-gradient(circle at 85% 15%, rgba(253,246,237,.12), transparent 40%),
                    linear-gradient(135deg, var(--primary) 0%, #2a1305 100%);
    }
    .blog-hero::before {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(rgba(253,246,237,.10) 1px, transparent 1px);
        background-size: 22px 22px;
        opacity: .5;
        pointer-events: none;
    }
    .blog-hero-inner { position: relative; z-index: 1; }
    .blog-hero .section-eyebrow {
        display: inline-flex; align-items: center; gap: .45rem;
        color: var(--accent-fg); background: rgba(212,112,74,.22);
        border: 1px solid rgba(212,112,74,.5);
        padding: .35rem .9rem; border-radius: 100px;
        font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; font-weight: 700;
        margin-bottom: 1.25rem;
    }
    .blog-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.3rem, 4.8vw, 3.4rem);
        line-height: 1.15;
        margin-bottom: 1rem;
    }
    .blog-hero p {
        max-width: 640px; margin: 0 auto; color: rgba(253,246,237,.82); line-height: 1.7; font-size: 1.05rem;
    }

    .blog-wrap { padding: 0 0 5rem; }

    /* Barra de filtros flutuante */
    .blog-filters-bar {
        max-width: 980px; margin: -1.75rem auto 3.5rem; padding: .9rem 1.25rem;
        background: var(--card); border: 1px solid var(--border); border-radius: 100px;
        box-shadow: var(--shadow-lg); position: relative; z-index: 2;
        display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center;
    }
    .blog-chip {
        padding: .5rem 1.15rem; border-radius: 100px; font-size: .85rem; font-weight: 700;
        border: none; color: var(--fg); background: transparent; transition: all .2s;
    }
    .blog-chip:hover { background: var(--muted); color: var(--fg); }
    .blog-chip.active { background: var(--primary); color: var(--primary-fg); box-shadow: 0 4px 14px rgba(92,46,14,.25); }

    /* Post em destaque */
    .blog-featured {
        display: grid; grid-template-columns: 1.15fr 1fr; align-items: stretch;
        background: var(--card); border: 1px solid var(--border); border-radius: 1.5rem;
        overflow: hidden; margin-bottom: 4.5rem; box-shadow: var(--shadow-lg);
        transition: box-shadow .25s;
    }
    .blog-featured:hover { box-shadow: 0 16px 44px rgba(92,46,14,.22); }
    .blog-featured-img { position: relative; min-height: 380px; overflow: hidden; }
    .blog-featured-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
    .blog-featured:hover .blog-featured-img img { transform: scale(1.05); }
    .blog-featured-body {
        padding: 2.75rem; display: flex; flex-direction: column; justify-content: center; gap: 1rem;
    }
    .blog-featured-badge {
        display: inline-flex; align-items: center; gap: .4rem; width: fit-content;
        background: var(--accent); color: var(--accent-fg);
        font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
        padding: .35rem .85rem; border-radius: 100px;
    }
    .blog-featured-title {
        font-family: 'Playfair Display', serif; font-size: clamp(1.55rem, 3vw, 2.25rem);
        color: var(--fg); line-height: 1.22;
    }
    .blog-featured-excerpt { color: var(--muted-fg); line-height: 1.75; }
    .blog-featured-cta {
        display: inline-flex; align-items: center; gap: .5rem; font-weight: 700; color: var(--primary);
        margin-top: .25rem;
    }
    .blog-featured-cta svg { width: 18px; height: 18px; transition: transform .2s; }
    .blog-featured:hover .blog-featured-cta svg { transform: translateX(4px); }

    /* Meta comum (autor, data, tempo leitura) */
    .blog-meta {
        display: flex; align-items: center; gap: .6rem; font-size: .82rem; color: var(--muted-fg); flex-wrap: wrap;
    }
    .blog-meta-avatar {
        width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
        background: var(--muted); display: flex; align-items: center; justify-content: center; font-size: 1rem;
    }
    .blog-meta-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .blog-meta-dot::before { content: '•'; margin: 0 .35rem; }

    /* Cabeçalho da grade */
    .blog-section-title {
        display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
        margin-bottom: 1.75rem; flex-wrap: wrap;
    }
    .blog-section-title h2 {
        font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--fg);
    }
    .blog-section-title span { color: var(--muted-fg); font-size: .9rem; }

    /* Grid de posts */
    .blog-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;
    }
    .blog-card {
        background: var(--card); border: 1px solid var(--border); border-radius: 1.1rem;
        overflow: hidden; display: flex; flex-direction: column; transition: all .3s;
    }
    .blog-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }
    .blog-card-img { position: relative; aspect-ratio: 16/10; overflow: hidden; }
    .blog-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s; }
    .blog-card:hover .blog-card-img img { transform: scale(1.08); }
    .blog-card-cat {
        position: absolute; top: .85rem; left: .85rem;
        background: rgba(44,24,16,.72); backdrop-filter: blur(4px); color: #fff;
        font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em;
        padding: .3rem .7rem; border-radius: 100px;
    }
    .blog-card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: .85rem; flex: 1; }
    .blog-card-title {
        font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--fg); line-height: 1.32;
    }
    .blog-card-excerpt { color: var(--muted-fg); font-size: .9rem; line-height: 1.6; flex: 1; }
    .blog-card-footer {
        display: flex; align-items: center; justify-content: space-between; gap: .5rem;
        padding-top: .85rem; border-top: 1px solid var(--border);
    }
    .blog-card-link {
        color: var(--primary); font-weight: 700; font-size: .82rem; display: inline-flex; align-items: center; gap: .3rem;
        white-space: nowrap;
    }
    .blog-card-link svg { width: 15px; height: 15px; transition: transform .2s; }
    .blog-card:hover .blog-card-link svg { transform: translateX(3px); }

    /* Newsletter CTA */
    .blog-newsletter {
        margin-top: 5rem; position: relative; overflow: hidden;
        background: linear-gradient(135deg, var(--primary) 0%, #3a1c0a 100%);
        border-radius: 1.5rem; padding: 3.25rem 2.5rem;
        text-align: center; color: var(--primary-fg);
    }
    .blog-newsletter-icon {
        width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 1rem;
        background: rgba(253,246,237,.12); display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: var(--accent-fg);
    }
    .blog-newsletter h3 { font-family: 'Playfair Display', serif; font-size: 1.7rem; margin-bottom: .6rem; }
    .blog-newsletter p { color: rgba(253,246,237,.82); max-width: 480px; margin: 0 auto 1.75rem; }
    .blog-newsletter-form { display: flex; gap: .6rem; max-width: 420px; margin: 0 auto; flex-wrap: wrap; justify-content: center; }
    .blog-newsletter-form input {
        flex: 1; min-width: 220px; padding: .85rem 1.2rem; border-radius: 100px; border: none; font-size: .9rem;
    }
    .blog-newsletter-form button {
        border-radius: 100px; padding: .85rem 1.6rem; font-weight: 700; border: none; cursor: pointer;
        background: var(--accent); color: var(--accent-fg); transition: all .2s;
    }
    .blog-newsletter-form button:hover { filter: brightness(1.08); transform: translateY(-1px); }

    .blog-empty {
        text-align: center; color: var(--muted-fg); padding: 4rem 1rem; border: 1px dashed var(--border);
        border-radius: 1.25rem; background: var(--card);
    }
    .blog-empty i { font-size: 2rem; color: var(--accent); margin-bottom: .75rem; display: block; }

    @@media (max-width: 900px) {
        .blog-featured { grid-template-columns: 1fr; }
        .blog-featured-img { min-height: 260px; }
        .blog-featured-body { padding: 2rem; }
        .blog-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 600px) {
        .blog-grid { grid-template-columns: 1fr; }
        .blog-filters-bar { border-radius: var(--radius); margin-top: -1.25rem; }
    }
</style>

<div class="page active">

    <section class="blog-hero">
        <div class="container blog-hero-inner">
            <span class="section-eyebrow"><i class="bi bi-journal-richtext"></i> Nosso Blog</span>
            <h1>Histórias, receitas e bastidores<br class="d-none d-md-block" /> do Doce Cantinho</h1>
            <p>
                Dicas de confeitaria, guias completos para eventos, curiosidades sobre ingredientes
                e um pouco dos bastidores da nossa cozinha — tudo escrito por quem faz o doce todos os dias.
            </p>
        </div>
    </section>

    <div class="container blog-wrap">

        @if (Model.Categories.Any())
        {
            <div class="blog-filters-bar">
                <a asp-action="Index" class="blog-chip @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                    <i class="bi bi-grid-fill"></i> Todos os posts
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index" asp-route-categoria="@cat"
                       class="blog-chip @(Model.SelectedCategory == cat ? "active" : "")">@cat</a>
                }
            </div>
        }

        @if (Model.FeaturedPost != null)
        {
            var f = Model.FeaturedPost;
            <a asp-action="Details" asp-route-id="@f.Slug" style="text-decoration:none;color:inherit;display:block">
                <article class="blog-featured">
                    <div class="blog-featured-img">
                        <img src="@Url.Content(f.CoverImageUrl)" onerror="this.src='https://placehold.co/900x600?text=Doce+Cantinho'" alt="@f.Title" />
                    </div>
                    <div class="blog-featured-body">
                        <span class="blog-featured-badge"><i class="bi bi-star-fill"></i> Post em destaque</span>
                        <h2 class="blog-featured-title">@f.Title</h2>
                        <p class="blog-featured-excerpt">@f.Excerpt</p>
                        <div class="blog-meta">
                            <span class="blog-meta-avatar">
                                <img src="@Url.Content(f.AuthorAvatar)" alt="@f.AuthorName" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;bi bi-person-fill&quot;></i>';" />
                            </span>
                            <span>@f.AuthorName</span>
                            <span class="blog-meta-dot"></span>
                            <span>@f.PublishedAt.ToString("dd MMM yyyy")</span>
                            <span class="blog-meta-dot"></span>
                            <span><i class="bi bi-clock"></i> @f.ReadingTimeMinutes min de leitura</span>
                        </div>
                        <span class="blog-featured-cta">
                            Ler artigo completo
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </span>
                    </div>
                </article>
            </a>
        }

        @if (Model.Posts.Any())
        {
            <div class="blog-section-title">
                <h2>Últimos artigos</h2>
                <span>@Model.Posts.Count() post(s) @(string.IsNullOrEmpty(Model.SelectedCategory) ? "" : $"em \"{Model.SelectedCategory}\"")</span>
            </div>
            <div class="blog-grid">
                @foreach (var post in Model.Posts)
                {
                    <a asp-action="Details" asp-route-id="@post.Slug" style="text-decoration:none;color:inherit">
                        <article class="blog-card">
                            <div class="blog-card-img">
                                <img src="@Url.Content(post.CoverImageUrl)" onerror="this.src='https://placehold.co/600x400?text=Doce+Cantinho'" alt="@post.Title" loading="lazy" />
                                <span class="blog-card-cat">@post.Category</span>
                            </div>
                            <div class="blog-card-body">
                                <h3 class="blog-card-title">@post.Title</h3>
                                <p class="blog-card-excerpt">@post.Excerpt</p>
                                <div class="blog-meta">
                                    <span><i class="bi bi-calendar3"></i> @post.PublishedAt.ToString("dd MMM yyyy")</span>
                                    <span class="blog-meta-dot"></span>
                                    <span><i class="bi bi-clock"></i> @post.ReadingTimeMinutes min</span>
                                </div>
                                <div class="blog-card-footer">
                                    <span class="blog-meta" style="gap:.4rem">
                                        <span class="blog-meta-avatar" style="width:24px;height:24px;font-size:.75rem">
                                            <img src="@Url.Content(post.AuthorAvatar)" alt="@post.AuthorName" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;bi bi-person-fill&quot;></i>';" />
                                        </span>
                                        @post.AuthorName
                                    </span>
                                    <span class="blog-card-link">
                                        Ler mais
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="5" y1="12" x2="19" y2="12" />
                                            <polyline points="12 5 19 12 12 19" />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </article>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="blog-empty">
                <i class="bi bi-journal-x"></i>
                <p>Nenhum post encontrado nessa categoria ainda.</p>
            </div>
        }

        <div class="blog-newsletter">
            <div class="blog-newsletter-icon"><i class="bi bi-envelope-heart-fill"></i></div>
            <h3 class="serif">Não perca nenhuma novidade</h3>
            <p>Assine nossa newsletter e receba receitas, dicas de confeitaria e novidades da loja direto no seu e-mail.</p>
            <form class="blog-newsletter-form" onsubmit="event.preventDefault(); alert('Obrigado! Em breve você receberá nossas novidades.'); this.reset();">
                <input type="email" placeholder="Seu melhor e-mail" required />
                <button type="submit">Assinar</button>
            </form>
        </div>

    </div>
</div>
