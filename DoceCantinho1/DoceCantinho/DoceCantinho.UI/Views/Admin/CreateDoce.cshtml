
@using DoceCantinho.Domain.Interfaces
@using Microsoft.AspNetCore.Mvc.Rendering
<link href="~/css/site.css" rel="stylesheet" />
@model DoceCantinho.Application.ViewModels.DoceFormViewModel

<div class="container mt-4">

    <h2>Novo Doce</h2>

    <form asp-action="CreateDoce" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label>Nome</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Descrição</label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Preço</label>
            <input asp-for="Preco"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Categoria</label>
            <select asp-for="CategoryId" class="form-control" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                <option value="">-- Selecione --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Imagem (URL)</label>
            <input asp-for="CoverImageUrl" class="form-control" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
            <label asp-for="IsFeatured" class="form-check-label">Destacar este doce</label>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsRecomendado" class="form-check-input" type="checkbox" />
            <label asp-for="IsRecomendado" class="form-check-label">Marcar como recomendado</label>
        </div>

        <div class="mb-3">
            <label>Imagem (arquivo)</label>
            <input type="file" name="imageFile" accept="image/*" class="form-control" />
            <small class="text-muted">Enviar um arquivo substitui a URL informada acima.</small>
        </div>

        <button class="btn btn-success">
            Salvar
        </button>

    </form>

</div>

<script src="~/js/site.js"></script>
